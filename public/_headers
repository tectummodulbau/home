# Cloudflare Pages — zusätzliche Response-Header

# Das Sitemap-Stylesheet muss als XSL ausgeliefert werden, sonst wenden
# Browser es nicht an und zeigen die Sitemap als rohes XML.
/sitemap.xsl
  Content-Type: text/xsl; charset=utf-8
  Cache-Control: public, max-age=3600

/sitemap-index.xml
  Content-Type: application/xml; charset=utf-8
  Cache-Control: public, max-age=3600

/sitemap-*.xml
  Content-Type: application/xml; charset=utf-8
  Cache-Control: public, max-age=3600
