---
const year = new Date().getFullYear();
---

<footer class="site-footer" id="kontakt">
  <div class="container site-footer__grid">
    <div class="site-footer__about">
      <p class="site-footer__brand">Tectum <em>Modulbau</em></p>
      <p>
        Hersteller modularer Tiny Houses für Betreiber, Kommunen und Händler.<br />
        DGNB-zertifiziert. Kauf und Leasing.
      </p>
      <a href="/#anfrage" class="btn btn--light">Unverbindliches Angebot</a>
    </div>

    <div>
      <h4>Kontakt</h4>
      <address>
        Tectum Ecobau GmbH &amp; Co. KG<br />
        Hohenzollern Platz 7<br />
        47167 Duisburg
      </address>
      <p>
        Telefon: <a href="tel:+4920393565788">+49 203 935 657 88</a><br />
        Mobil: <a href="tel:+4915256243044">+49 1525 624 3044</a><br />
        E-Mail: <a href="mailto:stankovic@ecobau-tectum.de">stankovic@ecobau-tectum.de</a>
      </p>
    </div>

    <div>
      <h4>Navigation</h4>
      <ul>
        <li><a href="/#module">Module</a></li>
        <li><a href="/#prinzip">Prinzip</a></li>
        <li><a href="/#konfigurator">Konfigurator</a></li>
        <li><a href="/#rechner">Ertragsrechner</a></li>
        <li><a href="/#ablauf">Ablauf</a></li>
        <li><a href="/#anfrage">Anfrage</a></li>
      </ul>
    </div>

    <div>
      <h4>Rechtliches</h4>
      <ul>
        <li><a href="/impressum/">Impressum</a></li>
        <li><a href="/datenschutz/">Datenschutz</a></li>
        <li><button type="button" class="site-footer__link-btn" data-privacy-settings-trigger>Datenschutz-Einstellungen</button></li>
      </ul>
    </div>
  </div>

  <div class="container site-footer__bottom">
    <p>© {year} Tectum Modulbau. Alle Rechte vorbehalten.</p>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--ink);
    color: rgba(255, 255, 255, 0.78);
    padding-top: clamp(3.5rem, 7vw, 5.5rem);
    font-size: 0.98rem;
  }

  .site-footer__grid {
    display: grid;
    grid-template-columns: 1.6fr 1.2fr 0.8fr 0.8fr;
    gap: clamp(2rem, 5vw, 4rem);
    padding-bottom: 3rem;
  }

  .site-footer__brand {
    font-family: var(--font-head);
    font-weight: 800;
    font-size: 1.35rem;
    color: var(--paper);
    margin-bottom: 0.8rem;
  }
  .site-footer__brand em {
    font-style: normal;
    font-weight: 500;
    color: rgba(255, 255, 255, 0.55);
  }

  .site-footer__about .btn { margin-top: 0.75rem; }
  .site-footer__about .btn--light { color: var(--ink); }
  .site-footer__about .btn--light:hover { color: var(--ink); }

  .site-footer h4 {
    color: var(--paper);
    font-size: 0.85rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    margin-bottom: 1.1rem;
  }

  .site-footer address { font-style: normal; margin-bottom: 0.9rem; }

  .site-footer ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.55rem;
  }

  .site-footer a {
    color: inherit;
    text-decoration: none;
  }
  .site-footer a:hover { color: var(--paper); }

  .site-footer__link-btn {
    font: inherit;
    color: inherit;
    background: none;
    border: none;
    padding: 0;
    margin: 0;
    text-align: left;
    cursor: pointer;
  }
  .site-footer__link-btn:hover { color: var(--paper); }
  .site-footer__link-btn:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  .site-footer__bottom {
    border-top: 1px solid rgba(255, 255, 255, 0.14);
    padding-block: 1.4rem;
    font-size: 0.88rem;
    color: rgba(255, 255, 255, 0.5);
  }
  .site-footer__bottom p { margin: 0; }

  @media (max-width: 920px) {
    .site-footer__grid { grid-template-columns: 1fr 1fr; }
  }
  @media (max-width: 560px) {
    .site-footer__grid { grid-template-columns: 1fr; }
  }
</style>
