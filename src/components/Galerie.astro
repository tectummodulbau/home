---
import { Image } from 'astro:assets';
import { lightboxImage, lightboxVideo } from '../lib/lightbox';
import imgWellness from '../assets/galerie-wellness.jpg';
import imgWohnraum from '../assets/galerie-wohnraum.jpg';
import imgWohnraumHoch from '../assets/galerie-wohnraum-sofa-hochformat.jpg';
import imgHolzwand from '../assets/galerie-wohnraum-holzwand.jpg';
import imgBad from '../assets/galerie-bad-waschtisch.jpg';
import imgDusche from '../assets/galerie-dusche-marmor.jpg';
import imgPool from '../assets/addon-aussenanlage.jpg';
import imgAufbauLuft from '../assets/aufbau-chassis-luftbild.jpg';
import imgAufbauMontage from '../assets/aufbau-trailer-montage.jpg';
import imgAussen from '../assets/galerie-aussen-terrasse.jpeg';
import imgKueche from '../assets/galerie-kueche-essplatz.jpeg';
import imgKuecheDetail from '../assets/galerie-kueche-detail.jpeg';
import imgKuehlschrank from '../assets/galerie-kuehlschrank.jpeg';
import imgDurchblick from '../assets/galerie-wohnraum-bad-durchblick.jpeg';
import imgDoppelbett from '../assets/galerie-schlafzimmer-doppelbett.jpeg';
import imgZweiBetten from '../assets/galerie-schlafzimmer-zwei-betten.jpeg';
import imgSchrank from '../assets/galerie-schrankwand.jpeg';
import imgBettDetail from '../assets/galerie-bett-detail.jpeg';
import imgGrundriss from '../assets/galerie-grundriss.jpeg';

const rohbilder = [
  { img: imgWellness, alt: 'Wellnessbereich einer Modulanlage von Tectum Modulbau', caption: 'Wellnessbereich', wide: true },
  { img: imgHolzwand, alt: 'Wohnraum mit Holzwand, Polstersofa, Küchenzeile und Essplatz in einer Tectum Moduleinheit', caption: 'Wohnraum mit Küchenzeile', wide: false },
  { img: imgWohnraum, alt: 'Innenausbau einer modularen Wohnraumeinheit von Tectum', caption: 'Wohnraumeinheit innen', wide: true },
  { img: imgWohnraumHoch, alt: 'Wohnraum einer Tectum Moduleinheit mit Sofa, Küchenzeile und Klimagerät', caption: 'Wohnen und Kochen', wide: false },
  { img: imgBad, alt: 'Badezimmer einer Tectum Moduleinheit mit Waschtisch, Spiegel und Marmoroptik', caption: 'Bad mit Waschtisch', wide: true },
  { img: imgDusche, alt: 'Dusche mit Glastür und Marmoroptik in einer Tectum Moduleinheit', caption: 'Dusche', wide: false },
  { img: imgPool, alt: 'Poolanlage als Außenbereich einer Tectum Moduleinheit', caption: 'Außenanlage mit Pool', full: true },
];

const projektBilder = [
  { img: imgAussen, alt: 'Tectum Modulhaus mit überdachter Holzterrasse, Glasfront und Kiesfläche auf einer Wiese', caption: 'Außenansicht mit Terrasse' },
  { img: imgKuecheDetail, alt: 'Küchenzeile mit Kaffeemaschine, Vorratsgläsern und Bilderrahmen in einer Tectum Moduleinheit', caption: 'Küche im Detail' },
  { img: imgKueche, alt: 'Küchenzeile mit Backofen, Waschmaschine und rundem Esstisch in einer Tectum Moduleinheit', caption: 'Küche und Essplatz' },
  { img: imgKuehlschrank, alt: 'Geöffneter Einbaukühlschrank in der Küche einer Tectum Moduleinheit', caption: 'Einbaukühlschrank' },
  { img: imgDurchblick, alt: 'Blick durch den Wohnraum mit Esstisch und Fernseher bis zum Bad und Schlafbereich einer Tectum Moduleinheit', caption: 'Wohnraum, Bad und Schlafbereich' },
  { img: imgDoppelbett, alt: 'Doppelbett mit Wandleuchten und Holzwand in einer Tectum Moduleinheit', caption: 'Schlafzimmer mit Doppelbett' },
  { img: imgZweiBetten, alt: 'Schlafbereich mit zwei Einzelbetten, Polsterpaneelen und Fernseher in einer Tectum Moduleinheit', caption: 'Schlafbereich mit zwei Betten' },
  { img: imgSchrank, alt: 'Schrankwand in Holzoptik mit Tür und Bett in einer Tectum Moduleinheit', caption: 'Schrankwand' },
  { img: imgBettDetail, alt: 'Bett mit Wandleuchte und Schrankwand in einer Tectum Moduleinheit', caption: 'Schlafen im Detail' },
  { img: imgGrundriss, alt: 'Grundriss einer Tectum Moduleinheit mit Küche, Bad, Schlafbereich und Wohnbereich, 1065,5 mal 382,5 Zentimeter', caption: 'Grundriss der Moduleinheit', plan: true },
];

const aufbau = [
  { img: imgAufbauLuft, alt: 'Aluminium Chassis mit Trailer wird auf einer Wiese vor der Tectum Halle aufgebaut', caption: 'Trailer und Aufleger: das Chassis steht' },
  { img: imgAufbauMontage, alt: 'Zwei Mitarbeiter montieren das Chassis des Aufliegers am Trailer', caption: 'Trailer und Aufleger: die Montage' },
];

const bilder = await Promise.all(
  rohbilder.map(async (b) => ({ ...b, lb: await lightboxImage(b.img, b.alt, b.caption) }))
);
const projekt = await Promise.all(
  projektBilder.map(async (b) => ({ ...b, lb: await lightboxImage(b.img, b.alt, b.caption) }))
);
const [projektHero, ...projektThumbs] = projekt;
const aufbauBilder = await Promise.all(
  aufbau.map(async (b) => ({ ...b, lb: await lightboxImage(b.img, b.alt, b.caption) }))
);

const wohnparkVideo = lightboxVideo(
  '/video/wohnpark-campingplatz.mp4',
  '/video/wohnpark-campingplatz-poster.jpg',
  'Rundgang durch einen Wohnpark mit Tectum Moduleinheiten, Terrassen und Außenanlage',
  'Wohnpark mit Tectum Einheiten'
);
---

<section class="section section--sand" id="galerie">
  <div class="container">
    <div class="section-head reveal">
      <span class="section-kicker">Einblicke</span>
      <h2>Ein Blick in unsere Moduleinheiten</h2>
    </div>

    <div class="gal-grid gal-grid--collapsed" id="gal-grid">
      {bilder.map((b) => (
        <figure class={`gal-item reveal ${b.wide ? 'gal-item--wide' : ''} ${b.full ? 'gal-item--full' : ''} ${b.plan ? 'gal-item--plan' : ''}`} {...b.lb}>
          <Image src={b.img} alt={b.alt} title={b.caption} widths={[500, 900]} sizes="(max-width: 720px) 100vw, 60vw" />
          <figcaption>{b.caption}</figcaption>
        </figure>
      ))}
    </div>

    <button type="button" class="btn btn--ghost gal-more" id="gal-more" aria-expanded="false" aria-controls="gal-grid">
      Weitere Bilder anzeigen
    </button>

    <article class="case reveal" id="projekt" aria-labelledby="case-titel">
      <div class="case__top">
        <figure class="case__hero gal-item gal-item--plain" {...projektHero.lb}>
          <Image src={projektHero.img} alt={projektHero.alt} title={projektHero.caption} widths={[700, 1200]} sizes="(max-width: 920px) 100vw, 55vw" />
          <figcaption>{projektHero.caption}</figcaption>
        </figure>
        <div class="case__copy">
          <span class="section-kicker">Projektbeispiel</span>
          <h3 id="case-titel">Eine Moduleinheit mit Terrasse, von innen und außen</h3>
          <p>
            Alle Bilder dieses Abschnitts gehören zu einer einzigen Einheit: Holzwand, Küchenzeile
            mit Essplatz, Bad, Schlafbereich und überdachte Terrasse. Der Grundriss misst etwa
            10,7 mal 3,8 Meter. Ein Klick auf ein Bild öffnet die Ansicht, in der Sie durch das
            ganze Projekt blättern können.
          </p>
          <a href="#anfrage" class="btn btn--solid">Angebot anfragen</a>
        </div>
      </div>
      <div class="case__thumbs">
        {projektThumbs.map((b) => (
          <figure class={`gal-item gal-item--plain case__thumb ${b.plan ? 'gal-item--plan' : ''}`} {...b.lb}>
            <Image src={b.img} alt={b.alt} title={b.caption} widths={[360, 640]} sizes="(max-width: 720px) 33vw, 18vw" />
            <figcaption>{b.caption}</figcaption>
          </figure>
        ))}
      </div>
    </article>
  </div>
</section>

<section class="section gal-white" id="praxis">
  <div class="container">
    <div class="gal-story gal-story--mobil reveal" id="mobil">
      <div class="gal-story__copy">
        <span class="section-kicker">Mobil bleiben</span>
        <h3>Ihr Tiny House auf Trailer und Aufleger</h3>
        <p>
          Wer flexibel bleiben will, setzt sein Tiny House auf einen Trailer mit Aufleger.
          Die Bilder zeigen, wie der Aufleger aufgebaut und am Trailer angebracht wird.
          So bleibt die Einheit beweglich und lässt sich an einem neuen Standort wieder aufstellen.
        </p>
        <a href="#anfrage" class="btn btn--solid">Projekt anfragen</a>
      </div>
      <div class="gal-story__media gal-story__media--pair">
        {aufbauBilder.map((b) => (
          <figure class="gal-item gal-item--plain" {...b.lb}>
            <Image src={b.img} alt={b.alt} title={b.caption} widths={[480, 900]} sizes="(max-width: 920px) 100vw, 40vw" />
            <figcaption>{b.caption}</figcaption>
          </figure>
        ))}
      </div>
    </div>

    <div class="gal-story gal-story--video reveal" id="wohnpark">
      <figure class="gal-item gal-item--plain gal-item--video" {...wohnparkVideo}>
        <img
          src="/video/wohnpark-campingplatz-poster.jpg"
          alt="Wohnpark mit Tectum Moduleinheiten, Holzterrassen und gepflegter Außenanlage"
          title="Wohnpark mit Tectum Einheiten"
          width="480"
          height="848"
          loading="lazy"
          decoding="async"
        />
        <span class="gal-play" aria-hidden="true">
          <svg viewBox="0 0 24 24" width="26" height="26" fill="currentColor"><path d="M8 5.5v13l11-6.5L8 5.5Z" /></svg>
        </span>
        <figcaption>Video ansehen</figcaption>
      </figure>
      <div class="gal-story__copy">
        <span class="section-kicker">Aus der Praxis</span>
        <h3>Ein kleiner Wohnpark, von der Planung bis zur Ausführung begleitet</h3>
        <p>
          Dieser Wohnpark ist ein Beispiel dafür, wie wir Projekte begleiten: von der ersten
          Planung bis zur fertigen Anlage mit Terrassen und Außenbereich.
        </p>
        <a href="#anfrage" class="btn btn--solid">Unverbindliche Projektprüfung</a>
      </div>
    </div>
  </div>
</section>

<script>
  const grid = document.getElementById('gal-grid');
  const more = document.getElementById('gal-more');
  more?.addEventListener('click', () => {
    const open = grid?.classList.toggle('gal-grid--collapsed') === false;
    more.setAttribute('aria-expanded', String(open));
    more.textContent = open ? 'Weniger Bilder anzeigen' : 'Weitere Bilder anzeigen';
    if (!open) grid?.scrollIntoView({ block: 'start' });
  });
</script>

<style>
  .gal-more { display: none; }

  /* Schwarzer Hauptbutton, beim Hover weiß mit Outline */
  .btn--solid {
    background: var(--ink);
    color: var(--paper);
    border-color: var(--ink);
  }
  .btn--solid:hover {
    background: var(--paper);
    color: var(--ink);
    border-color: var(--ink);
  }

  /* Weiße Fläche für Mobil und Praxis, abgesetzt von den Einblicken */
  .gal-white {
    background: var(--paper);
    padding-top: clamp(5rem, 10vw, 8.5rem);
  }
  .gal-white .gal-story:first-child { margin-top: 0; }
  .gal-white .gal-story + .gal-story { margin-top: clamp(4rem, 8vw, 6.5rem); }

  /* Projektbeispiel */
  .case {
    margin-top: clamp(3rem, 6vw, 5rem);
    background: var(--paper);
    border-radius: var(--radius-lg);
    padding: clamp(1rem, 2.4vw, 1.8rem);
    box-shadow: var(--shadow-md);
  }
  .case__top {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(0, 0.75fr);
    gap: clamp(1.4rem, 3.5vw, 3rem);
    align-items: center;
  }
  .case .case__hero img { height: auto; aspect-ratio: 3 / 2; }
  .case__copy { padding: 0 clamp(0rem, 1.5vw, 1rem); }
  .case__copy h3 { margin: 0.3rem 0 0.8rem; }
  .case__copy p { color: var(--muted); margin: 0 0 1.5rem; }
  .case__thumbs {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: clamp(0.5rem, 1vw, 0.8rem);
    margin-top: clamp(0.8rem, 1.6vw, 1.2rem);
  }
  .case__thumb { border-radius: var(--radius); }
  .case .case__thumb img { height: auto; aspect-ratio: 4 / 3; }
  .case__thumb figcaption { display: none; }
  .case__thumb.gal-item--plan { grid-column: span 2; border: 1px solid var(--sand); }
  .case .case__thumb.gal-item--plan img { aspect-ratio: auto; height: 100%; }

  .gal-grid {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: clamp(0.9rem, 2vw, 1.4rem);
  }

  .gal-item {
    position: relative;
    margin: 0;
    border-radius: var(--radius-lg);
    overflow: hidden;
    grid-column: span 2;
  }
  .gal-item--wide { grid-column: span 3; }
  .gal-item--full { grid-column: 1 / -1; }

  .gal-item img {
    width: 100%;
    height: 320px;
    object-fit: cover;
    transition: transform 0.5s ease;
  }
  .gal-item:hover img { transform: scale(1.04); }

  .gal-item figcaption {
    position: absolute;
    left: 1rem;
    bottom: 1rem;
    font-family: var(--font-head);
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--paper);
    background: rgba(20, 19, 15, 0.72);
    padding: 0.4rem 0.95rem;
    border-radius: 999px;
    backdrop-filter: blur(4px);
  }


  .gal-item img { display: block; }
  .gal-item--plan { background: #fff; }
  .gal-item--plan img { object-fit: contain; }
  .gal-item--plan:hover img { transform: none; }

  /* Geschichten unter dem Raster: Trailer und Wohnpark */
  .gal-story {
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
    gap: clamp(1.6rem, 4vw, 3.5rem);
    align-items: center;
    margin-top: clamp(3rem, 6vw, 5rem);
  }
  .gal-story--video { grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr); }
  .gal-story__copy h3 { margin: 0.3rem 0 0.8rem; }
  .gal-story__copy p { color: var(--muted); margin: 0 0 1.5rem; max-width: 32rem; }

  .gal-story__media--pair {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(0.8rem, 1.6vw, 1.1rem);
  }
  .gal-item--plain { grid-column: auto; }
  .gal-story__media--pair .gal-item img { height: 300px; }
  .gal-story--video .gal-item img { height: auto; aspect-ratio: 16 / 9; }

  .gal-play {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 72px;
    height: 72px;
    margin: -36px 0 0 -36px;
    display: grid;
    place-items: center;
    border-radius: 50%;
    color: var(--ink);
    background: rgba(255, 255, 255, 0.92);
    box-shadow: var(--shadow-md);
    transition: transform 0.3s ease;
  }
  .gal-item--video:hover .gal-play { transform: scale(1.08); }

  @media (max-width: 920px) {
    .case__top { grid-template-columns: 1fr; }
    .case__thumbs { grid-template-columns: repeat(4, minmax(0, 1fr)); }
    .case__thumb.gal-item--plan { grid-column: span 4; }
    .gal-story,
    .gal-story--video { grid-template-columns: 1fr; }
    .gal-story--video .gal-story__copy { order: 2; }
  }

  @media (max-width: 720px) {
    .gal-grid { grid-template-columns: 1fr; }
    .gal-grid--collapsed .gal-item:nth-child(n + 5) { display: none; }
    .gal-more { display: inline-flex; margin: 1.4rem auto 0; }
    .gal-more { justify-content: center; width: 100%; }
    .gal-item, .gal-item--wide, .gal-item--full { grid-column: auto; }
    .gal-item img { height: 240px; }
    .case__thumbs { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .case__thumb.gal-item--plan { grid-column: span 2; }
    .case .case__thumb img { height: auto; }
    .gal-story__media--pair { grid-template-columns: 1fr; }
    .gal-story__media--pair .gal-item img { height: 240px; }
  }
</style>
