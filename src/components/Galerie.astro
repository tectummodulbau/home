---
import { Image } from 'astro:assets';
import { lightboxImage, lightboxVideo } from '../lib/lightbox';
import imgWellness from '../assets/galerie-wellness.jpg';
import imgProduktion from '../assets/galerie-produktion.jpg';
import imgWohnraum from '../assets/galerie-wohnraum.jpg';
import imgWohnraumHoch from '../assets/galerie-wohnraum-sofa-hochformat.jpg';
import imgHolzwand from '../assets/galerie-wohnraum-holzwand.jpg';
import imgBad from '../assets/galerie-bad-waschtisch.jpg';
import imgDusche from '../assets/galerie-dusche-marmor.jpg';
import imgPool from '../assets/addon-aussenanlage.jpg';
import imgAufbauLuft from '../assets/aufbau-chassis-luftbild.jpg';
import imgAufbauMontage from '../assets/aufbau-trailer-montage.jpg';

const rohbilder = [
  { img: imgWellness, alt: 'Wellnessbereich einer Modulanlage von Tectum Modulbau', caption: 'Wellnessbereich', wide: true },
  { img: imgHolzwand, alt: 'Wohnraum mit Holzwand, Polstersofa, Küchenzeile und Essplatz in einer Tectum Moduleinheit', caption: 'Wohnraum mit Küchenzeile', wide: false },
  { img: imgWohnraum, alt: 'Innenausbau einer modularen Wohnraumeinheit von Tectum', caption: 'Wohnraumeinheit innen', wide: true },
  { img: imgWohnraumHoch, alt: 'Wohnraum einer Tectum Moduleinheit mit Sofa, Küchenzeile und Klimagerät', caption: 'Wohnen und Kochen', wide: false },
  { img: imgProduktion, alt: 'CNC Fertigung der Modulhäuser in der Tectum Holzwerkstatt', caption: 'Fertigung im Werk', wide: false },
  { img: imgBad, alt: 'Badezimmer einer Tectum Moduleinheit mit Waschtisch, Spiegel und Marmoroptik', caption: 'Bad mit Waschtisch', wide: true },
  { img: imgDusche, alt: 'Dusche mit Glastür und Marmoroptik in einer Tectum Moduleinheit', caption: 'Dusche', wide: false },
  { img: imgPool, alt: 'Poolanlage als Außenbereich einer Tectum Moduleinheit', caption: 'Außenanlage mit Pool', wide: true },
];

const aufbau = [
  { img: imgAufbauLuft, alt: 'Aluminium Chassis mit Trailer wird auf einer Wiese vor der Tectum Halle aufgebaut', caption: 'Trailer und Aufleger: das Chassis steht' },
  { img: imgAufbauMontage, alt: 'Zwei Mitarbeiter montieren das Chassis des Aufliegers am Trailer', caption: 'Trailer und Aufleger: die Montage' },
];

const bilder = await Promise.all(
  rohbilder.map(async (b) => ({ ...b, lb: await lightboxImage(b.img, b.alt, b.caption) }))
);
const aufbauBilder = await Promise.all(
  aufbau.map(async (b) => ({ ...b, lb: await lightboxImage(b.img, b.alt, b.caption) }))
);

const wohnparkVideo = lightboxVideo(
  '/video/wohnpark-campingplatz.mp4',
  '/video/wohnpark-campingplatz-poster.jpg',
  'Rundgang durch einen Wohnpark mit Tectum Moduleinheiten, Terrassen und Außenanlage',
  'Wohnpark mit Tectum Einheiten'
);
---

<section class="section section--sand" id="galerie">
  <div class="container">
    <div class="section-head reveal">
      <span class="section-kicker">Einblicke</span>
      <h2>Gebaut im Werk. Gemacht für den Betrieb.</h2>
    </div>

    <div class="gal-grid">
      {bilder.map((b) => (
        <figure class={`gal-item reveal ${b.wide ? 'gal-item--wide' : ''}`} {...b.lb}>
          <Image src={b.img} alt={b.alt} widths={[500, 900]} sizes="(max-width: 720px) 100vw, 60vw" />
          <figcaption>{b.caption}</figcaption>
        </figure>
      ))}
    </div>

    <div class="gal-story gal-story--mobil reveal" id="mobil">
      <div class="gal-story__copy">
        <span class="section-kicker">Mobil bleiben</span>
        <h3>Ihr Tiny House auf Trailer und Aufleger</h3>
        <p>
          Wer flexibel bleiben will, setzt sein Tiny House auf einen Trailer mit Aufleger.
          Die Bilder zeigen, wie der Aufleger aufgebaut und am Trailer angebracht wird.
          So bleibt die Einheit beweglich und lässt sich an einem neuen Standort wieder aufstellen.
        </p>
        <a href="#anfrage" class="btn btn--ghost">Projekt anfragen</a>
      </div>
      <div class="gal-story__media gal-story__media--pair">
        {aufbauBilder.map((b) => (
          <figure class="gal-item gal-item--plain" {...b.lb}>
            <Image src={b.img} alt={b.alt} widths={[480, 900]} sizes="(max-width: 920px) 100vw, 40vw" />
            <figcaption>{b.caption}</figcaption>
          </figure>
        ))}
      </div>
    </div>

    <div class="gal-story gal-story--video reveal" id="wohnpark">
      <figure class="gal-item gal-item--plain gal-item--video" {...wohnparkVideo}>
        <img
          src="/video/wohnpark-campingplatz-poster.jpg"
          alt="Wohnpark mit Tectum Moduleinheiten, Holzterrassen und gepflegter Außenanlage"
          width="480"
          height="848"
          loading="lazy"
          decoding="async"
        />
        <span class="gal-play" aria-hidden="true">
          <svg viewBox="0 0 24 24" width="26" height="26" fill="currentColor"><path d="M8 5.5v13l11-6.5L8 5.5Z" /></svg>
        </span>
        <figcaption>Video ansehen</figcaption>
      </figure>
      <div class="gal-story__copy">
        <span class="section-kicker">Aus der Praxis</span>
        <h3>Ein kleiner Wohnpark, von der Planung bis zur Ausführung begleitet</h3>
        <p>
          Dieser Wohnpark ist ein Beispiel dafür, wie wir Projekte begleiten: von der ersten
          Planung bis zur fertigen Anlage mit Terrassen und Außenbereich.
        </p>
        <a href="#anfrage" class="btn btn--ghost">Unverbindliche Projektprüfung</a>
      </div>
    </div>
  </div>
</section>

<style>
  .gal-grid {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: clamp(0.9rem, 2vw, 1.4rem);
  }

  .gal-item {
    position: relative;
    margin: 0;
    border-radius: var(--radius-lg);
    overflow: hidden;
    grid-column: span 2;
  }
  .gal-item--wide { grid-column: span 3; }

  .gal-item img {
    width: 100%;
    height: 320px;
    object-fit: cover;
    transition: transform 0.5s ease;
  }
  .gal-item:hover img { transform: scale(1.04); }

  .gal-item figcaption {
    position: absolute;
    left: 1rem;
    bottom: 1rem;
    font-family: var(--font-head);
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--paper);
    background: rgba(20, 19, 15, 0.72);
    padding: 0.4rem 0.95rem;
    border-radius: 999px;
    backdrop-filter: blur(4px);
  }


  .gal-item img { display: block; }

  /* Geschichten unter dem Raster: Trailer und Wohnpark */
  .gal-story {
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
    gap: clamp(1.6rem, 4vw, 3.5rem);
    align-items: center;
    margin-top: clamp(3rem, 6vw, 5rem);
  }
  .gal-story--video { grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr); }
  .gal-story__copy h3 { margin: 0.3rem 0 0.8rem; }
  .gal-story__copy p { color: var(--muted); margin: 0 0 1.5rem; max-width: 32rem; }

  .gal-story__media--pair {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(0.8rem, 1.6vw, 1.1rem);
  }
  .gal-item--plain { grid-column: auto; }
  .gal-story__media--pair .gal-item img { height: 300px; }
  .gal-story--video .gal-item img { height: auto; aspect-ratio: 16 / 9; }

  .gal-play {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 72px;
    height: 72px;
    margin: -36px 0 0 -36px;
    display: grid;
    place-items: center;
    border-radius: 50%;
    color: var(--ink);
    background: rgba(255, 255, 255, 0.92);
    box-shadow: var(--shadow-md);
    transition: transform 0.3s ease;
  }
  .gal-item--video:hover .gal-play { transform: scale(1.08); }

  @media (max-width: 920px) {
    .gal-story,
    .gal-story--video { grid-template-columns: 1fr; }
    .gal-story--video .gal-story__copy { order: 2; }
  }

  @media (max-width: 720px) {
    .gal-grid { grid-template-columns: 1fr; }
    .gal-item, .gal-item--wide { grid-column: auto; }
    .gal-item img { height: 240px; }
    .gal-story__media--pair { grid-template-columns: 1fr; }
    .gal-story__media--pair .gal-item img { height: 240px; }
  }
</style>
