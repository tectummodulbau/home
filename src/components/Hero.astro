---
import { Image } from 'astro:assets';
import logoDgnb from '../assets/logo-dgnb.png';
import logoTuevNord from '../assets/logo-tuev-nord.png';
import logoTuevSued from '../assets/logo-tuev-sued.png';
import logoFsc from '../assets/logo-fsc.png';
import logoInnovator from '../assets/logo-innovator.png';
import { heroScene, heroSpots } from '../lib/iso/scenes';

// Intrinsische Höhe bewusst großzügig gewählt (max. Anzeigehöhe auf Desktop
// ist 76 px). Mit densities werden zusätzliche 2×/3×-Varianten generiert,
// damit die Logos auf Retina-Displays und beim CSS-Hochskalieren scharf
// bleiben.
const zertifikate = [
  { src: logoDgnb, alt: 'DGNB — Deutsche Gesellschaft für Nachhaltiges Bauen' },
  { src: logoTuevNord, alt: 'TÜV Nord zertifiziert' },
  { src: logoTuevSued, alt: 'TÜV Süd zertifiziert' },
  { src: logoFsc, alt: 'FSC-zertifiziertes Holz' },
  { src: logoInnovator, alt: 'Innovator des Jahres 2025' },
];
// Liste verdoppelt, damit der Slider (Mobil/Tablet) nahtlos loopt. Auf dem
// Desktop stehen die Logos nebeneinander, die Kopien werden dort ausgeblendet.
const zertifikateLoop = [
  ...zertifikate.map((z) => ({ ...z, dup: false })),
  ...zertifikate.map((z) => ({ ...z, dup: true })),
];

const szene = heroScene();
const spots = heroSpots();
---

<section class="hero">
  <div class="hero__grid-bg" aria-hidden="true"></div>

  <div class="container hero__grid">
    <div class="hero__copy">
      <span class="hero__kicker"><i aria-hidden="true"></i>Modulbau-Hersteller · B2B ab 10 Einheiten</span>
      <h1>
        <span class="hero__line" style="--i:0">Modulhäuser &amp; Tiny Häuser.</span>
        <span class="hero__line hero__line--accent" style="--i:1">Geliefert. Zertifiziert. Sofort einsatzbereit.</span>
      </h1>
      <p class="hero__lead">
        Tectum ist Hersteller schlüsselfertiger Modulhäuser und modular kombinierbarer
        Wohneinheiten für Campingplatzbetreiber, Kommunen, Wohnparks und Wiederverkäufer.
        DGNB-zertifiziert, fertig ab Werk in wenigen Wochen. Kauf und Leasing möglich.
      </p>
      <div class="hero__actions">
        <a href="#anfrage" class="btn btn--primary btn--lg">Unverbindliches Angebot</a>
        <a href="#rechner" class="btn btn--ghost btn--lg">Rendite berechnen</a>
      </div>
      <p class="hero__micro">
        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5" /></svg>
        Kostenlos &amp; unverbindlich · Antwort innerhalb von 24 Stunden
      </p>
      <ul class="hero__facts">
        <li><strong>GEG</strong><span>konforme Bauweise</span></li>
        <li><strong>ab 10</strong><span>Einheiten skalierbar</span></li>
        <li><strong>Wochen</strong><span>statt Monate Bauzeit</span></li>
      </ul>
    </div>

    <div class="hero__stage" data-tilt>
      <Fragment set:html={szene} />
      <ul class="hero__spots" aria-hidden="true">
        {spots.map((s, i) => (
          <li class={`hero__spot hero__spot--${s.side}`} style={`left:${s.x}%;top:${s.y}%;--i:${i}`}>
            <i></i><span>{s.label}</span>
          </li>
        ))}
      </ul>
    </div>
  </div>

  <div class="container hero__certs">
    <div class="hero__certs-bar">
      <span class="hero__trust-label">Zertifiziert &amp; ausgezeichnet</span>
      <div class="hero__certs-track-wrap">
        <div class="hero__certs-track">
          {zertifikateLoop.map((z) => (
            <span class:list={['hero__cert', { 'hero__cert--dup': z.dup }]} aria-hidden={z.dup ? 'true' : undefined}>
              <Image src={z.src} alt={z.dup ? '' : z.alt} title={z.dup ? undefined : z.alt} height={80} densities={[1.5, 2, 3]} loading={z.dup ? 'lazy' : 'eager'} />
            </span>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    background:
      radial-gradient(ellipse 60% 70% at 78% 40%, #fbf7ee 0%, rgba(251, 247, 238, 0) 70%),
      linear-gradient(180deg, #f4f1ea 0%, #ffffff 100%);
  }

  /* Skizzenpapier: feines Raster, nach außen ausgeblendet */
  .hero :global(.container) {
    padding-inline: clamp(5%, 6vw, 9%);
  }

  .hero__grid-bg {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(20, 19, 15, 0.045) 1px, transparent 1px),
      linear-gradient(90deg, rgba(20, 19, 15, 0.045) 1px, transparent 1px);
    background-size: 44px 44px;
    mask-image: radial-gradient(ellipse 70% 80% at 70% 40%, #000 20%, transparent 75%);
    -webkit-mask-image: radial-gradient(ellipse 70% 80% at 70% 40%, #000 20%, transparent 75%);
    pointer-events: none;
  }

  .hero__grid {
    position: relative;
    display: grid;
    gap: clamp(0.5rem, 3vw, 2rem);
    align-items: center;
    padding-block: clamp(5.2rem, 14vw, 6.5rem) clamp(1rem, 3vw, 2rem);
  }

  .hero__kicker {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    font-family: var(--font-head);
    font-size: 0.76rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ink-soft);
    background: rgba(255, 255, 255, 0.8);
    border: 1px solid var(--line);
    border-radius: 999px;
    padding: 0.45rem 0.95rem;
    margin-bottom: 1.3rem;
  }
  .hero__kicker i {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 0 0 rgba(200, 169, 110, 0.6);
    animation: hero-pulse 2.4s ease-out infinite;
  }
  @keyframes hero-pulse {
    to { box-shadow: 0 0 0 10px rgba(200, 169, 110, 0); }
  }

  h1 {
    font-size: clamp(2.1rem, 4.4vw, 3.5rem);
    line-height: 1.06;
    margin-bottom: 1.1rem;
  }
  .hero__line {
    display: block;
  }
  .hero__line--accent {
    margin-top: 0.15em;
    font-size: 0.62em;
    font-weight: 700;
    letter-spacing: -0.01em;
    color: var(--muted);
  }

  .hero__lead {
    font-size: 1.12rem;
    color: var(--muted);
    max-width: 33rem;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem;
    margin-top: 1.6rem;
  }

  .hero__micro {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin: 1rem 0 0;
    font-size: 0.88rem;
    color: var(--ink-soft);
  }
  .hero__micro svg { color: var(--green); flex-shrink: 0; }

  .hero__facts {
    list-style: none;
    display: flex;
    gap: clamp(1.4rem, 4vw, 2.8rem);
    padding: 1.4rem 0 0;
    margin: 1.8rem 0 0;
    border-top: 1px solid var(--line);
  }
  .hero__facts li { display: flex; flex-direction: column; gap: 0.15rem; }
  .hero__facts strong {
    font-family: var(--font-head);
    font-weight: 800;
    font-size: 1.45rem;
  }
  .hero__facts span { font-size: 0.86rem; color: var(--muted); }

  /* ---------- 3D-Bühne ---------- */
  .hero__stage {
    position: relative;
    width: 100%;
    max-width: 760px;
    margin-inline: auto;
  }
  .hero__stage :global(.iso) {
    filter: drop-shadow(0 30px 40px rgba(20, 19, 15, 0.12));
  }

  .hero__spots {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .hero__spot {
    position: absolute;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    transform: translate(-7px, -50%);
    opacity: 0;
    animation: hero-spot-in 0.6s ease calc(2.1s + var(--i) * 0.25s) forwards;
    pointer-events: none;
  }
  .hero__spot--l { flex-direction: row-reverse; transform: translate(calc(-100% + 7px), -50%); }
  .hero__spot i {
    flex-shrink: 0;
    width: 14px;
    height: 14px;
    border-radius: 50%;
    background: var(--accent);
    border: 3px solid #fff;
    box-shadow: 0 0 0 0 rgba(200, 169, 110, 0.7), 0 2px 8px rgba(20, 19, 15, 0.25);
    animation: hero-pulse 2.4s ease-out infinite;
  }
  .hero__spot span {
    font-family: var(--font-head);
    font-size: 0.72rem;
    font-weight: 700;
    color: var(--ink);
    background: rgba(255, 255, 255, 0.94);
    border-radius: 999px;
    padding: 0.28rem 0.7rem;
    white-space: nowrap;
    box-shadow: var(--shadow-sm);
  }
  @keyframes hero-spot-in {
    from { opacity: 0; margin-top: 8px; }
    to { opacity: 1; margin-top: 0; }
  }
  @media (max-width: 640px) {
    .hero__spot span { display: none; }
  }

  /* ---------- Zertifikate (bleiben vorn) ---------- */
  .hero__certs {
    position: relative;
    padding-bottom: clamp(1.5rem, 4vw, 3rem);
  }
  .hero__certs-bar {
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
    background: #fff;
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-md);
    padding: 1.1rem clamp(1rem, 3vw, 2rem) 1.2rem;
  }
  .hero__trust-label {
    font-family: var(--font-head);
    font-size: 0.74rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--muted);
    text-align: center;
  }
  .hero__certs-track-wrap {
    overflow: hidden;
    mask-image: linear-gradient(to right, transparent, black 7%, black 93%, transparent);
    -webkit-mask-image: linear-gradient(to right, transparent, black 7%, black 93%, transparent);
  }
  .hero__certs-track {
    display: flex;
    align-items: center;
    gap: clamp(2.5rem, 6vw, 4.5rem);
    width: max-content;
    animation: hero-certs-scroll 28s linear infinite;
  }
  .hero__certs-track:hover { animation-play-state: paused; }
  .hero__cert { display: inline-flex; align-items: center; flex-shrink: 0; }
  .hero__cert img {
    width: auto;
    height: 48px;
    object-fit: contain;
    transition: transform 0.25s ease;
  }
  .hero__cert:hover img { transform: scale(1.08); }

  @keyframes hero-certs-scroll {
    from { transform: translateX(0); }
    to { transform: translateX(-50%); }
  }

  /* Mobil: Überschrift, 3D-Szene, dann CTA — die Szene ist der erste Eindruck,
     der Button bleibt trotzdem im ersten Bildschirm erreichbar. */
  @media (max-width: 959px) {
    .hero__copy { display: contents; }
    .hero__copy > .hero__kicker { order: 1; align-self: flex-start; }
    .hero__copy > h1 { order: 2; margin-bottom: 0; }
    .hero__stage { order: 3; margin-block: -0.4rem -0.2rem; }
    .hero__copy > .hero__actions { order: 4; margin-top: 0; }
    .hero__copy > .hero__micro { order: 5; margin-top: 0; }
    .hero__copy > .hero__lead { order: 6; margin: 0; }
    .hero__copy > .hero__facts { order: 7; margin: 0; }
    .hero__grid { gap: 1rem; }
    .hero__actions .btn { flex: 1 1 100%; }
  }

  @media (min-width: 960px) {
    /* Die Kopfleiste liegt über dem Hero (negativer Rand im Header), daher
       Platz für sie oben im Hero; die Szene rückt nach oben, damit Kennzahlen
       im ersten Bildschirm stehen. */
    .hero__grid {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.12fr);
      gap: clamp(1rem, 2vw, 2rem);
      align-items: start;
      padding-block: clamp(8rem, 13vh, 9.5rem) 0.5rem;
    }
    .hero__copy { position: relative; z-index: 2; }
    /* Beide Überschriftzeilen je in einer Zeile; dürfen in die Bühne hineinragen */
    h1 { white-space: nowrap; font-size: clamp(2.1rem, 3.7vw, 3.4rem); margin-bottom: 1.3rem; }
    .hero__line--accent { white-space: nowrap; margin-top: 0.3em; font-size: 0.56em; }
    .hero__kicker { margin-bottom: 1.6rem; }
    .hero__lead { font-size: 1.05rem; line-height: 1.6; }
    .hero__actions { margin-top: 1.6rem; }
    .hero__micro { margin-top: 1rem; }
    .hero__facts { margin-top: 1.8rem; padding-top: 1.3rem; }
    .hero__stage { margin-top: clamp(0.5rem, 3vh, 2.5rem); z-index: 1; }

    /* Zertifikate: schlanker Streifen unter dem ersten Bildschirm */
    .hero__certs { padding-block: 1.2rem clamp(1.5rem, 3vw, 2.5rem); }
    .hero__certs-bar {
      flex-direction: row;
      align-items: center;
      gap: 2rem;
      padding: 0.7rem clamp(1rem, 3vw, 2rem);
      border-radius: 999px;
      box-shadow: var(--shadow-sm);
    }
    .hero__trust-label { text-align: left; white-space: nowrap; font-size: 0.7rem; }
    .hero__certs-track-wrap { flex: 1; min-width: 0; }
    .hero__cert img { height: 38px; }
  }

  /* Desktop: alle Logos passen nebeneinander, kein Slider */
  @media (min-width: 1100px) {
    .hero__certs-track-wrap {
      mask-image: none;
      -webkit-mask-image: none;
    }
    .hero__certs-track {
      width: 100%;
      justify-content: space-between;
      gap: 1.5rem;
      animation: none;
    }
    .hero__cert--dup { display: none; }
  }

  /* Eintritts-Animation Text */
  @media (prefers-reduced-motion: no-preference) {
    .hero__kicker,
    .hero__line,
    .hero__lead,
    .hero__actions,
    .hero__micro,
    .hero__facts {
      animation: hero-up 0.8s cubic-bezier(0.2, 0.85, 0.25, 1) both;
    }
    .hero__kicker { animation-delay: 0.05s; }
    .hero__line { animation-delay: calc(0.15s + var(--i) * 0.14s); }
    .hero__lead { animation-delay: 0.45s; }
    .hero__actions { animation-delay: 0.55s; }
    .hero__micro { animation-delay: 0.65s; }
    .hero__facts { animation-delay: 0.75s; }
    @keyframes hero-up {
      from { opacity: 0; transform: translateY(18px); }
      to { opacity: 1; transform: none; }
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__certs-track { animation: none; flex-wrap: wrap; justify-content: center; width: auto; }
    .hero__cert--dup { display: none; }
    .hero__spot { opacity: 1; animation: none; }
  }
</style>
