---
import { Image } from 'astro:assets';
import logoDgnb from '../assets/logo-dgnb.png';
import logoTuevNord from '../assets/logo-tuev-nord.png';
import logoTuevSued from '../assets/logo-tuev-sued.png';
import logoFsc from '../assets/logo-fsc.png';
import logoInnovator from '../assets/logo-innovator.png';

// Intrinsische Höhe bewusst großzügig gewählt (max. Anzeigehöhe auf Desktop
// ist 76 px). Mit densities werden zusätzliche 2×/3×-Varianten generiert,
// damit die Logos auf Retina-Displays und beim CSS-Hochskalieren scharf
// bleiben. Vorher wurden die Bilder in Zwerggröße erzeugt (2 kB pro Logo)
// und sichtbar unscharf hochgerechnet.
const zertifikate = [
  { src: logoDgnb, alt: 'DGNB — Deutsche Gesellschaft für Nachhaltiges Bauen' },
  { src: logoTuevNord, alt: 'TÜV Nord zertifiziert' },
  { src: logoTuevSued, alt: 'TÜV Süd zertifiziert' },
  { src: logoFsc, alt: 'FSC-zertifiziertes Holz' },
  { src: logoInnovator, alt: 'Innovator des Jahres 2025' },
];
// Liste verdoppelt, damit der Slider nahtlos loopt.
const zertifikateLoop = [...zertifikate, ...zertifikate];
---

<section class="hero">
  <div class="container hero__grid">
    <div class="hero__copy">
      <span class="section-kicker">Tectum Modulbau</span>
      <h1>Modulhäuser &amp; Tiny Häuser. Geliefert. Zertifiziert. Sofort einsatzbereit.</h1>
      <p class="hero__lead">
        Tectum liefert schlüsselfertige Modulhäuser und modular kombinierbare Wohneinheiten für
        Campingplatzbetreiber, Kommunen, Wohnparks und Wiederverkäufer. DGNB-zertifiziert, fertig
        ab Werk in wenigen Wochen. Kauf und Leasing möglich.
      </p>
      <div class="hero__actions">
        <a href="#anfrage" class="btn btn--primary">Unverbindliches Angebot</a>
        <a href="#module" class="btn btn--ghost">Unsere Module</a>
      </div>
      <ul class="hero__facts">
        <li><strong>GEG</strong><span>konforme Bauweise</span></li>
        <li><strong>ab 10</strong><span>Einheiten skalierbar</span></li>
        <li><strong>Wochen</strong><span>statt Monate Bauzeit</span></li>
      </ul>
    </div>

    <div class="hero__media">
      <div class="hero__video-wrap" id="hero-video-wrap">
        <video
          class="hero__video"
          id="hero-video"
          poster="/video/hero-film-poster.jpg"
          autoplay
          muted
          loop
          playsinline
          preload="metadata"
          aria-label="Tectum Moduleinheit — Imagefilm"
        >
          <source src="/video/hero-film.mp4" type="video/mp4" />
        </video>

        <div class="hero__video-controls" role="group" aria-label="Videosteuerung">
          <button type="button" class="hero__video-btn" id="hero-video-play" aria-label="Video pausieren" aria-pressed="false">
            <svg class="icon-pause" viewBox="0 0 24 24" width="16" height="16" fill="currentColor" aria-hidden="true"><rect x="6" y="5" width="4" height="14" rx="1" /><rect x="14" y="5" width="4" height="14" rx="1" /></svg>
            <svg class="icon-play is-icon-hidden" viewBox="0 0 24 24" width="16" height="16" fill="currentColor" aria-hidden="true"><path d="M7 5.5v13l11-6.5-11-6.5Z" /></svg>
          </button>
          <button type="button" class="hero__video-btn" id="hero-video-stop" aria-label="Video stoppen">
            <svg viewBox="0 0 24 24" width="14" height="14" fill="currentColor" aria-hidden="true"><rect x="5.5" y="5.5" width="13" height="13" rx="1.5" /></svg>
          </button>
          <button type="button" class="hero__video-btn" id="hero-video-mute" aria-label="Ton einschalten" aria-pressed="true">
            <svg class="icon-muted" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M11 5 6 9H3v6h3l5 4V5Z" /><path d="M16 9.5c1 1.5 1 3.5 0 5" /><line x1="19.5" y1="6.5" x2="15" y2="17.5" /></svg>
            <svg class="icon-unmuted is-icon-hidden" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M11 5 6 9H3v6h3l5 4V5Z" /><path d="M16 9.5c1 1.5 1 3.5 0 5" /><path d="M18.5 7.5c2 2.5 2 6.5 0 9" /></svg>
          </button>
        </div>
      </div>

      <div class="hero__certs">
        <span class="hero__trust-label">Zertifiziert &amp; ausgezeichnet</span>
        <div class="hero__certs-track-wrap">
          <div class="hero__certs-track">
            {zertifikateLoop.map((z) => (
              <span class="hero__cert">
                <Image src={z.src} alt={z.alt} height={80} densities={[1.5, 2, 3]} loading="eager" />
              </span>
            ))}
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    background: var(--paper);
    overflow: hidden;
  }

  .hero__grid {
    display: flex;
    flex-direction: column;
    gap: clamp(1rem, 3vw, 2.5rem);
    padding-block: clamp(1.5rem, 5vw, 6.5rem) clamp(2.5rem, 6vw, 6.5rem);
  }

  /* Mobile-first: .hero__copy löst sich optisch auf, damit seine Kinder
     zusammen mit dem Medien-Block direkt im Flex angeordnet werden können.
     Reihenfolge: Subheader, Header, Video+Zertifikate, Buttons, Text, Kennzahlen —
     damit CTA und Vertrauenssignale direkt im ersten Sichtbereich landen. */
  .hero__copy { display: contents; }

  .hero__copy > .section-kicker { order: 1; }
  .hero__copy > h1 { order: 2; }
  .hero__media { order: 3; }
  .hero__copy > .hero__actions { order: 4; }
  .hero__copy > .hero__lead { order: 5; }
  .hero__copy > .hero__facts { order: 6; }

  .hero__lead {
    font-size: 1.15rem;
    color: var(--muted);
    max-width: 34rem;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.9rem;
  }

  .hero__facts {
    list-style: none;
    display: flex;
    gap: clamp(1.5rem, 4vw, 2.8rem);
    padding: 0;
    margin: 0;
  }
  .hero__facts li {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }
  .hero__facts strong {
    font-family: var(--font-head);
    font-weight: 800;
    font-size: 1.45rem;
  }
  .hero__facts span {
    font-size: 0.86rem;
    color: var(--muted);
  }

  /* Video und Zertifikate — kein umschließender Kasten mehr */
  .hero__media {
    display: flex;
    flex-direction: column;
    gap: clamp(1rem, 2.5vw, 1.6rem);
  }

  .hero__video-wrap {
    position: relative;
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow-md);
  }

  .hero__video {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 9;
    max-height: 48vh;
    object-fit: contain;
    background: var(--ink);
  }

  .hero__video-controls {
    position: absolute;
    right: 0.7rem;
    bottom: 0.7rem;
    display: flex;
    gap: 0.4rem;
  }

  .hero__video-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 34px;
    height: 34px;
    border-radius: 50%;
    border: none;
    background: rgba(20, 19, 15, 0.6);
    color: var(--paper);
    cursor: pointer;
    backdrop-filter: blur(2px);
    transition: background 0.15s ease, transform 0.15s ease;
  }
  .hero__video-btn:hover { background: rgba(20, 19, 15, 0.85); }
  .hero__video-btn:active { transform: scale(0.94); }
  .hero__video-btn .is-icon-hidden { display: none; }
  .hero__video-btn:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  .hero__certs {
    flex-shrink: 0;
  }
  .hero__trust-label {
    display: block;
    font-family: var(--font-head);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--muted);
    margin-bottom: 1rem;
  }

  .hero__certs-track-wrap {
    overflow: hidden;
    mask-image: linear-gradient(to right, transparent, black 8%, black 92%, transparent);
    -webkit-mask-image: linear-gradient(to right, transparent, black 8%, black 92%, transparent);
  }
  .hero__certs-track {
    display: flex;
    align-items: center;
    gap: clamp(2.5rem, 6vw, 4.5rem);
    width: max-content;
    animation: hero-certs-scroll 26s linear infinite;
  }
  .hero__certs-track:hover { animation-play-state: paused; }

  .hero__cert {
    display: inline-flex;
    align-items: center;
    flex-shrink: 0;
  }
  .hero__cert img {
    width: auto;
    height: 52px;
    object-fit: contain;
  }

  @media (min-width: 1024px) {
    .hero__cert img {
      height: 68px;
    }
  }

  @keyframes hero-certs-scroll {
    from { transform: translateX(0); }
    to { transform: translateX(-50%); }
  }

  /* Ab 1180px: zweispaltiges Layout, linke und rechte Spalte vertikal zentriert
     zueinander. Video und Zertifikate bilden rechts einen gemeinsamen Block.
     Unterhalb bleibt die mobile-first Reihenfolge (Subheader, Header,
     Video/Zertifikate, Buttons, Text, Kennzahlen) für Tablet und Mobile aktiv. */
  @media (min-width: 1180px) {
    /* Container-Innenabstand für den Hero reduzieren, damit im Mittelfeld
       (1180–1599px) beide Spalten atmen können. Ab 1600px übernimmt die
       Standard-Container-Breite wieder. */
    .hero :global(.container) {
      padding-inline: clamp(4%, 6vw, 8%);
    }

    .hero__grid {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr);
      grid-template-areas: "copy media";
      gap: clamp(1rem, 2.2vw, 2rem);
      align-items: center;
      min-height: calc(100vh - 92px);
    }

    .hero__copy { display: block; grid-area: copy; }
    .hero__copy > .section-kicker,
    .hero__copy > h1,
    .hero__copy > .hero__actions,
    .hero__copy > .hero__lead,
    .hero__copy > .hero__facts {
      order: initial;
    }
    .hero__copy > h1 { font-size: clamp(2.2rem, 3.6vw, 3.4rem); }
    .hero__media { grid-area: media; order: initial; }
    .hero__video { max-height: none; }
    .hero__cert img { height: 60px; }

    .hero__actions { margin-top: 1.4rem; }
    .hero__facts { margin: 2rem 0 0; }
  }

  @media (min-width: 1600px) {
    .hero :global(.container) { padding-inline: 10%; }
    .hero__grid {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: clamp(2rem, 4vw, 4rem);
    }
    .hero__copy > h1 { font-size: clamp(2.6rem, 4vw, 3.6rem); }
    .hero__cert img { height: 76px; }
    .hero__actions { margin-top: 1.8rem; }
    .hero__facts { margin: 2.6rem 0 0; }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__certs-track { animation: none; flex-wrap: wrap; }
  }
</style>

<script>
  import { trackOnce } from '../lib/analytics/tracker';

  const video = document.getElementById('hero-video') as HTMLVideoElement | null;
  const playBtn = document.getElementById('hero-video-play') as HTMLButtonElement | null;
  const stopBtn = document.getElementById('hero-video-stop') as HTMLButtonElement | null;
  const muteBtn = document.getElementById('hero-video-mute') as HTMLButtonElement | null;

  if (video && playBtn && stopBtn && muteBtn) {
    const iconPause = playBtn.querySelector('.icon-pause') as HTMLElement;
    const iconPlay = playBtn.querySelector('.icon-play') as HTMLElement;
    const iconMuted = muteBtn.querySelector('.icon-muted') as HTMLElement;
    const iconUnmuted = muteBtn.querySelector('.icon-unmuted') as HTMLElement;

    function syncPlayState() {
      const isPlaying = !video!.paused && !video!.ended;
      iconPause.classList.toggle('is-icon-hidden', !isPlaying);
      iconPlay.classList.toggle('is-icon-hidden', isPlaying);
      playBtn!.setAttribute('aria-pressed', String(isPlaying));
      playBtn!.setAttribute('aria-label', isPlaying ? 'Video pausieren' : 'Video abspielen');
    }

    function syncMuteState() {
      const isMuted = video!.muted;
      iconMuted.classList.toggle('is-icon-hidden', !isMuted);
      iconUnmuted.classList.toggle('is-icon-hidden', isMuted);
      muteBtn!.setAttribute('aria-pressed', String(!isMuted));
      muteBtn!.setAttribute('aria-label', isMuted ? 'Ton einschalten' : 'Ton ausschalten');
    }

    playBtn.addEventListener('click', () => {
      if (video.paused || video.ended) {
        video.play();
        // Nur nutzerinitiiertes Starten zählt. Das Video läuft mit
        // autoplay/muted/loop — würde man das play-Event des Elements
        // auswerten, wäre video_play faktisch ein zweiter Seitenaufruf und
        // kein Engagement-Signal.
        trackOnce('video_play', 'video_play');
      } else {
        video.pause();
      }
    });

    stopBtn.addEventListener('click', () => {
      video.pause();
      video.currentTime = 0;
    });

    muteBtn.addEventListener('click', () => {
      video.muted = !video.muted;
    });

    video.addEventListener('play', syncPlayState);
    video.addEventListener('pause', syncPlayState);
    video.addEventListener('volumechange', syncMuteState);

    syncPlayState();
    syncMuteState();
  }
</script>
