---
import { Image } from 'astro:assets';
import imgFitness from '../assets/addon-fitness.jpg';
import imgSauna from '../assets/addon-sauna.jpg';
import imgAussen from '../assets/addon-aussenanlage.jpg';

const addons = [
  {
    img: imgFitness,
    alt: 'Fitnesseinheit als modulare Erweiterung einer Modulhaus-Anlage von Tectum Modulbau',
    imgTitle: 'Fitnesseinheit — Zusatzmodul',
    title: 'Fitnesseinheit',
    text: 'Ein eigener Fitnessbereich als direkte Erweiterung Ihrer Tectum-Einheit. Ausstattung und Größe werden individuell abgestimmt — kauf- oder leasingfähig wie alle Tectum-Produkte.',
  },
  {
    img: imgSauna,
    alt: 'Saunaeinheit als Zusatzmodul für Glamping-Unterkünfte und Wohnparks von Tectum Modulbau',
    imgTitle: 'Saunaeinheit — Zusatzmodul',
    title: 'Sauna & Wellness',
    text: 'Wellness als fester Bestandteil Ihres Projekts. Tectum-Einheiten sind um einen individuell konfigurierten Wellnessbereich erweiterbar — schlüsselfertig, ohne separates Gewerk, ohne zusätzliche Baustelle.',
  },
  {
    img: imgAussen,
    alt: 'Außenanlage mit Pool für Campingplätze und Wohnparks von Tectum Modulbau',
    imgTitle: 'Außenanlage mit Pool',
    title: 'Außenanlage',
    text: 'Jede Tectum-Einheit lässt sich um einen vollwertigen Außenbereich erweitern. Ob Poolanlage, Whirlpool oder gestaltete Terrasse — die Konfiguration wird individuell abgestimmt und gemeinsam mit der Haupteinheit geliefert.',
  },
];
---

<section class="section section--dark" id="konfiguration">
  <div class="container">
    <div class="section-head section-head--center reveal">
      <span class="section-kicker">Konfiguration</span>
      <h2>Mehr als vier Wände. Konfigurieren Sie Ihr Angebot.</h2>
      <p class="section-lead">
        Alle Tectum-Einheiten lassen sich frei kombinieren und mit Zusatzmodulen erweitern. Ob
        Fitnessraum, Sauna, Wellnessbereich oder Außenanlage — so entsteht aus einzelnen
        Wohneinheiten eine komplette Anlage, die Ihre Gäste begeistert und Ihren Ertrag steigert.
      </p>
    </div>

    <div class="kf-grid">
      {addons.map((a) => (
        <article class="kf-card reveal">
          <div class="kf-card__media">
            <Image src={a.img} alt={a.alt} title={a.imgTitle} widths={[400, 700]} sizes="(max-width: 920px) 100vw, 33vw" />
          </div>
          <div class="kf-card__body">
            <h3>{a.title}</h3>
            <p>{a.text}</p>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .kf-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(1.2rem, 2.5vw, 2rem);
  }

  .kf-card {
    border-radius: var(--radius-lg);
    overflow: hidden;
    border: 1px solid var(--line);
    background: var(--paper);
    color: var(--ink);
    transition: transform 0.25s ease, box-shadow 0.25s ease;
  }
  .kf-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-md);
  }

  .kf-card__media img {
    width: 100%;
    height: 240px;
    object-fit: cover;
  }

  .kf-card__body { padding: 1.5rem 1.6rem 1.7rem; }
  .kf-card__body h3 { margin-bottom: 0.45rem; }
  .kf-card__body p {
    color: var(--muted);
    font-size: 0.98rem;
    margin: 0;
  }

  @media (max-width: 920px) {
    .kf-grid { grid-template-columns: 1fr; }

    :global(#konfiguration .section-head--center) {
      margin-inline: 0;
      text-align: left;
    }
  }
</style>
