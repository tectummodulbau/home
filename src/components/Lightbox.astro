---
// Lightbox für Bilder und Videos. Einmal pro Seite einbinden.
// Trigger siehe src/lib/lightbox.ts (Attribut data-lb).
---

<dialog class="lb" id="lightbox" aria-label="Bildergalerie" hidden>
  <div class="lb__bar">
    <span class="lb__count" id="lb-count" aria-live="polite"></span>
    <button type="button" class="lb__btn" id="lb-close" aria-label="Schließen">
      <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M5 5l14 14M19 5L5 19" /></svg>
    </button>
  </div>

  <button type="button" class="lb__btn lb__nav lb__nav--prev" id="lb-prev" aria-label="Vorheriges Bild">
    <svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 5l-7 7 7 7" /></svg>
  </button>
  <button type="button" class="lb__btn lb__nav lb__nav--next" id="lb-next" aria-label="Nächstes Bild">
    <svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 5l7 7-7 7" /></svg>
  </button>

  <figure class="lb__figure">
    <div class="lb__stage" id="lb-stage"></div>
    <figcaption class="lb__caption" id="lb-caption"></figcaption>
  </figure>
</dialog>

<style is:global>
  .lb {
    position: fixed;
    inset: 0;
    width: 100%;
    max-width: none;
    height: 100%;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: rgba(14, 13, 10, 0.94);
    color: #fff;
    overflow: hidden;
  }
  .lb:not([open]) { display: none; }
  .lb[open] { display: grid; grid-template-rows: auto 1fr; animation: lb-in 0.22s ease; }
  .lb::backdrop { background: rgba(14, 13, 10, 0.94); }
  @keyframes lb-in { from { opacity: 0; } to { opacity: 1; } }

  .lb__bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.9rem clamp(0.9rem, 3vw, 1.6rem);
    font-family: var(--font-head);
    font-size: 0.9rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    color: rgba(255, 255, 255, 0.75);
  }

  .lb__btn {
    display: inline-grid;
    place-items: center;
    width: 46px;
    height: 46px;
    border: 1px solid rgba(255, 255, 255, 0.22);
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.08);
    color: #fff;
    cursor: pointer;
    transition: background 0.2s ease, border-color 0.2s ease;
  }
  .lb__btn:hover { background: rgba(255, 255, 255, 0.18); border-color: rgba(255, 255, 255, 0.5); }
  .lb__btn:focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; }

  .lb__nav {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    z-index: 2;
  }
  .lb__nav--prev { left: clamp(0.6rem, 2vw, 1.5rem); }
  .lb__nav--next { right: clamp(0.6rem, 2vw, 1.5rem); }
  .lb[data-single] .lb__nav { display: none; }

  .lb__figure {
    margin: 0;
    min-height: 0;
    display: grid;
    grid-template-rows: minmax(0, 1fr) auto;
    justify-items: center;
    padding: 0 clamp(3.4rem, 8vw, 6rem) 1.2rem;
    touch-action: pan-y;
  }
  .lb__stage {
    min-height: 0;
    width: 100%;
    display: grid;
    place-items: center;
  }
  .lb__stage img,
  .lb__stage video {
    max-width: 100%;
    max-height: 100%;
    width: auto;
    height: auto;
    object-fit: contain;
    border-radius: 6px;
    background: #000;
    animation: lb-in 0.25s ease;
  }
  .lb__caption {
    padding-top: 0.9rem;
    font-family: var(--font-head);
    font-size: 0.95rem;
    font-weight: 600;
    text-align: center;
    color: rgba(255, 255, 255, 0.88);
  }

  @media (max-width: 720px) {
    .lb__figure { padding-inline: 0.6rem; }
    .lb__nav { top: auto; bottom: 0.9rem; transform: none; }
    .lb__nav--prev { left: 0.9rem; }
    .lb__nav--next { right: 0.9rem; }
    .lb__caption { padding-bottom: 3.6rem; }
  }

  /* Klickbare Vorschauen */
  [data-lb] { cursor: zoom-in; }
  [data-lb="video"] { cursor: pointer; }
  [data-lb]:focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; }
  html.lb-open { overflow: hidden; }

  @media (prefers-reduced-motion: reduce) {
    .lb[open], .lb__stage img, .lb__stage video { animation: none; }
  }
</style>

<script>
  type Item = { type: string; src: string; poster: string; alt: string; caption: string };

  const dialog = document.getElementById('lightbox') as HTMLDialogElement | null;
  if (dialog) {
    const stage = document.getElementById('lb-stage') as HTMLElement;
    const captionEl = document.getElementById('lb-caption') as HTMLElement;
    const countEl = document.getElementById('lb-count') as HTMLElement;
    const prevBtn = document.getElementById('lb-prev') as HTMLButtonElement;
    const nextBtn = document.getElementById('lb-next') as HTMLButtonElement;
    const closeBtn = document.getElementById('lb-close') as HTMLButtonElement;

    // Elemente in DOM Reihenfolge sammeln, gleiche Quelle nur einmal.
    const triggers = Array.from(document.querySelectorAll<HTMLElement>('[data-lb]'));
    const items: Item[] = [];
    const indexBySrc = new Map<string, number>();
    const indexOfTrigger = new Map<HTMLElement, number>();
    for (const el of triggers) {
      const src = el.dataset.lbSrc ?? '';
      if (!src) continue;
      if (!indexBySrc.has(src)) {
        indexBySrc.set(src, items.length);
        items.push({
          type: el.dataset.lb ?? 'image',
          src,
          poster: el.dataset.lbPoster ?? '',
          alt: el.dataset.lbAlt ?? '',
          caption: el.dataset.lbCaption ?? '',
        });
      }
      indexOfTrigger.set(el, indexBySrc.get(src)!);
    }

    let current = 0;
    let lastFocus: HTMLElement | null = null;
    dialog.toggleAttribute('data-single', items.length < 2);

    const preload = (i: number) => {
      const it = items[(i + items.length) % items.length];
      if (it && it.type === 'image') new Image().src = it.src;
    };

    const show = (i: number) => {
      current = (i + items.length) % items.length;
      const it = items[current];
      stage.replaceChildren();
      if (it.type === 'video') {
        const v = document.createElement('video');
        v.controls = true;
        v.autoplay = true;
        v.playsInline = true;
        v.preload = 'metadata';
        if (it.poster) v.poster = it.poster;
        v.src = it.src;
        v.setAttribute('aria-label', it.alt);
        stage.appendChild(v);
      } else {
        const img = document.createElement('img');
        img.src = it.src;
        img.alt = it.alt;
        img.decoding = 'async';
        stage.appendChild(img);
      }
      captionEl.textContent = it.caption;
      countEl.textContent = `${current + 1} / ${items.length}`;
      preload(current + 1);
      preload(current - 1);
    };

    const open = (i: number, from: HTMLElement) => {
      lastFocus = from;
      dialog.hidden = false;
      show(i);
      if (!dialog.open) dialog.showModal();
      document.documentElement.classList.add('lb-open');
      closeBtn.focus();
    };

    const close = () => {
      if (dialog.open) dialog.close();
    };

    dialog.addEventListener('close', () => {
      stage.replaceChildren(); // stoppt laufende Videos
      dialog.hidden = true;
      document.documentElement.classList.remove('lb-open');
      lastFocus?.focus({ preventScroll: true });
    });

    for (const [el, i] of indexOfTrigger) {
      el.addEventListener('click', () => open(i, el));
      el.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          open(i, el);
        }
      });
    }

    prevBtn.addEventListener('click', () => show(current - 1));
    nextBtn.addEventListener('click', () => show(current + 1));
    closeBtn.addEventListener('click', close);

    // Klick neben das Medium schließt.
    dialog.addEventListener('click', (e) => {
      const t = e.target as HTMLElement;
      if (t === dialog || t.classList.contains('lb__figure') || t === stage) close();
    });

    dialog.addEventListener('keydown', (e) => {
      if (items.length < 2) return;
      if (e.key === 'ArrowLeft') { e.preventDefault(); show(current - 1); }
      if (e.key === 'ArrowRight') { e.preventDefault(); show(current + 1); }
    });

    // Wischen auf Touchgeräten.
    let startX = 0;
    let startY = 0;
    dialog.addEventListener('touchstart', (e) => {
      startX = e.touches[0].clientX;
      startY = e.touches[0].clientY;
    }, { passive: true });
    dialog.addEventListener('touchend', (e) => {
      if ((e.target as HTMLElement).tagName === 'VIDEO') return;
      const dx = e.changedTouches[0].clientX - startX;
      const dy = e.changedTouches[0].clientY - startY;
      if (Math.abs(dx) > 50 && Math.abs(dx) > Math.abs(dy) * 1.5) show(current + (dx < 0 ? 1 : -1));
    }, { passive: true });
  }
</script>
