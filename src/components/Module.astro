---
import { variantScene } from '../lib/iso/scenes';
import { SPEC, type Variant } from '../lib/iso/objects';

/** Grundriss als Skizze (Meter-Koordinaten). */
function grundriss(v: Variant): string {
  const { w, d } = SPEC[v];
  const wall = 0.09;
  const bed = (x: number, y: number) =>
    `<rect x="${x}" y="${y}" width="0.9" height="1.9" rx="0.06" fill="#fff" stroke="#14130f" stroke-width="0.03"/><rect x="${x + 0.08}" y="${y + 0.08}" width="0.74" height="0.4" rx="0.05" fill="#e7e3da"/>`;
  const sofa = (x: number, y: number) =>
    `<rect x="${x}" y="${y}" width="1.9" height="0.8" rx="0.1" fill="#fff" stroke="#14130f" stroke-width="0.03"/><rect x="${x}" y="${y}" width="1.9" height="0.22" rx="0.08" fill="#e7e3da"/>`;
  const bad = (x: number) =>
    `<rect x="${x + 0.15}" y="0.2" width="0.7" height="0.4" rx="0.08" fill="#fff" stroke="#14130f" stroke-width="0.03"/><rect x="${x + 0.2}" y="${d - 0.75}" width="0.6" height="0.55" rx="0.05" fill="#fff" stroke="#14130f" stroke-width="0.03"/><circle cx="${x + 1.4}" cy="${d - 0.5}" r="0.26" fill="#fff" stroke="#14130f" stroke-width="0.03"/>`;
  const kueche = (x0: number, x1: number) =>
    `<rect x="${x0 + 0.15}" y="0.12" width="${x1 - x0 - 0.3}" height="0.6" fill="#fff" stroke="#14130f" stroke-width="0.03"/><circle cx="${x0 + 0.6}" cy="0.42" r="0.14" fill="none" stroke="#14130f" stroke-width="0.025"/><circle cx="${x0 + 1.0}" cy="0.42" r="0.14" fill="none" stroke="#14130f" stroke-width="0.025"/>`;

  type Room = { x0: number; x1: number; label: string; inner: string };
  let rooms: Room[] = [];
  if (v === 'schlaf') {
    rooms = [
      { x0: 0, x1: 2.0, label: 'Bad', inner: bad(0) },
      { x0: 2.0, x1: 4.1, label: 'Schlafen', inner: bed(2.25, 0.35) + bed(3.2, 0.35) },
      { x0: 4.1, x1: 6.2, label: 'Schlafen', inner: bed(4.35, 0.35) + bed(5.3, 0.35) },
    ];
  } else if (v === 'wohn') {
    rooms = [
      { x0: 0, x1: 2.0, label: 'Bad', inner: bad(0) },
      { x0: 2.0, x1: 5.6, label: 'Küche · Wohnen', inner: kueche(2.0, 5.6) + sofa(3.2, 1.55) },
      { x0: 5.6, x1: 7.4, label: 'Schlafen', inner: bed(6.05, 0.4) },
    ];
  } else {
    rooms = [
      { x0: 0, x1: 2.4, label: 'Bad', inner: bad(0.1) },
      { x0: 2.4, x1: 4.7, label: 'Küche', inner: kueche(2.4, 4.7) },
      { x0: 4.7, x1: 7.0, label: 'Wohnen', inner: sofa(4.95, 1.9) },
      { x0: 7.0, x1: 9.2, label: 'Schlafen', inner: bed(7.4, 0.5) + `<rect x="8.4" y="0.5" width="0.5" height="0.5" fill="#fff" stroke="#14130f" stroke-width="0.03"/>` },
    ];
  }
  const fmt = (n: number) => n.toLocaleString('de-DE', { minimumFractionDigits: 1 });
  let s = `<svg class="md-plan" viewBox="-0.9 -1.1 ${w + 1.8} ${d + 2.1}" role="img" aria-label="Grundriss ${v === 'schlaf' ? 'Schlafeinheit' : v === 'wohn' ? 'Wohnraumeinheit' : 'Luxuseinheit'}, ${fmt(w)} mal ${fmt(d)} Meter">`;
  s += `<rect x="0" y="0" width="${w}" height="${d}" fill="#fbf9f4"/>`;
  rooms.forEach((r, i) => {
    s += r.inner;
    s += `<text x="${(r.x0 + r.x1) / 2}" y="${d - 0.14}" font-size="0.24" text-anchor="middle" fill="#7a7a72" font-family="Urbanist, sans-serif" font-weight="600">${r.label}</text>`;
    if (i) s += `<path d="M${r.x0} 0V${d}" stroke="#14130f" stroke-width="0.05"/><rect x="${r.x0 - 0.02}" y="${d / 2 - 0.4}" width="0.08" height="0.8" fill="#fbf9f4"/>`;
  });
  s += `<rect x="0" y="0" width="${w}" height="${d}" fill="none" stroke="#14130f" stroke-width="${wall * 1.6}"/>`;
  // Fensteröffnungen (Längsseite unten)
  s += `<path d="M${w * 0.34} ${d}H${w * 0.78}" stroke="#8fa9b8" stroke-width="0.14"/>`;
  // Maße
  s += `<g stroke="#c8a96e" stroke-width="0.03" fill="none"><path d="M0 -0.45H${w}M0 -0.6V-0.3M${w} -0.6V-0.3"/><path d="M${w + 0.45} 0V${d}M${w + 0.3} 0H${w + 0.6}M${w + 0.3} ${d}H${w + 0.6}"/></g>`;
  s += `<text x="${w / 2}" y="-0.6" font-size="0.3" text-anchor="middle" fill="#8a6f3a" font-family="Urbanist, sans-serif" font-weight="700">${fmt(w)} m</text>`;
  s += `<text x="${w + 0.72}" y="${d / 2}" font-size="0.3" text-anchor="middle" fill="#8a6f3a" font-family="Urbanist, sans-serif" font-weight="700" transform="rotate(90 ${w + 0.72} ${d / 2})">${fmt(d)} m</text>`;
  return s + '</svg>';
}

const module = [
  {
    key: 'schlaf' as Variant,
    badge: 'Maximale Belegung',
    title: 'Schlafeinheit',
    subtitle: 'Modulare Unterkunft · 4 Personen',
    text: 'Die kompakte Lösung für maximale Belegung. Zwei Schlafzimmer mit je zwei Betten und einem vollausgestatteten Badezimmer. Ideal für Campingplätze, Wohnparks und Arbeitnehmerunterkünfte.',
    features: ['2 Schlafzimmer', '4 Betten', 'Vollbad', 'Klimaanlage', 'Wärmepumpe', 'PV optional'],
  },
  {
    key: 'wohn' as Variant,
    badge: 'Für Langzeitbelegung',
    title: 'Wohnraumeinheit',
    subtitle: 'Modulare Unterkunft · 4 Personen',
    text: 'Wohnen auf kompakter Fläche — mit allem, was es braucht. Küche, Wohnraum, Schlafbereich und Badezimmer unter einem Dach. Für Familien, Langzeitbelegung und gehobene Freizeitanlagen.',
    features: ['Küche', 'Wohnbereich', 'Schlafbereich', 'Vollbad', 'Klimaanlage', 'Wärmepumpe', 'PV optional'],
  },
  {
    key: 'luxus' as Variant,
    badge: 'Premium',
    title: 'Luxuseinheit',
    subtitle: 'Modulare Unterkunft · 4 Personen',
    text: 'Großzügige Flächen, hochwertige Ausstattung. Die Premiumoption für Glamping-Anlagen und exklusive Wohnparks. Mehr Raum in Küche, Bad, Wohnbereich und Schlafzimmer.',
    features: ['Erweiterte Fläche', 'Premium-Küche', 'Wohnbereich', 'Schlafbereich', 'Vollbad', 'Klimaanlage', 'PV optional'],
  },
];

const calcKey: Record<Variant, string> = { schlaf: 'schlaf', wohn: 'family', luxus: 'luxus' };
---

<section class="section section--stone" id="module">
  <div class="container md-container">
    <div class="section-head section-head--center reveal">
      <span class="section-kicker">Unsere Module</span>
      <h2>Drei Grundmodule. Beliebig kombinierbar.</h2>
      <p class="section-lead">
        Jedes Modulhaus wird schlüsselfertig geliefert — wählen Sie das Modul, das zu Ihrem
        Betrieb passt, und kombinieren Sie beliebig.
      </p>
    </div>

    <div class="md-grid">
      {module.map((m, i) => (
        <article class="md-card iso-card reveal" style={`--i:${i}`}>
          <div class="md-card__top">
            <span class="md-card__badge">{m.badge}</span>
            <div class="md-card__switch" role="group" aria-label="Ansicht wählen">
              <button type="button" class="is-active" data-view="3d" aria-pressed="true">3D</button>
              <button type="button" data-view="plan" aria-pressed="false">Grundriss</button>
            </div>
          </div>

          <div class="md-card__media">
            <div class="md-card__view md-card__view--3d" data-pane="3d">
              <Fragment set:html={variantScene(m.key, m.key)} />
            </div>
            <div class="md-card__view md-card__view--plan" data-pane="plan" hidden>
              <Fragment set:html={grundriss(m.key)} />
            </div>
          </div>

          <div class="md-card__body">
            <h3>{m.title}</h3>
            <p class="md-card__subtitle">{m.subtitle}</p>
            <p class="md-card__text">{m.text}</p>
            <ul class="md-card__features">
              {m.features.map((f) => <li class="chip">{f}</li>)}
            </ul>
            <div class="md-card__actions">
              <a href="#anfrage" class="btn btn--primary md-card__cta">Angebot anfragen</a>
              <a href="#rechner" class="md-card__calc" data-calc-variant={calcKey[m.key]}>Ertrag mit dieser Einheit rechnen <span aria-hidden="true">→</span></a>
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .md-container { padding-inline: clamp(5%, 8vw, 12%); }

  .md-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(1rem, 2vw, 1.6rem);
    align-items: stretch;
  }

  .md-card {
    display: flex;
    flex-direction: column;
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    overflow: hidden;
    transition: box-shadow 0.35s ease, transform 0.65s ease, opacity 0.65s ease;
  }
  .md-card:hover {
    box-shadow: var(--shadow-md);
  }

  .md-card__top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 0.6rem;
    padding: 1rem 1.1rem 0;
  }
  .md-card__badge {
    font-family: var(--font-head);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #8a6f3a;
    background: #f6efe0;
    border-radius: 999px;
    padding: 0.32rem 0.75rem;
  }
  .md-card__switch {
    display: inline-flex;
    background: var(--stone);
    border-radius: 999px;
    padding: 3px;
  }
  .md-card__switch button {
    font-family: var(--font-head);
    font-size: 0.76rem;
    font-weight: 700;
    border: 0;
    background: transparent;
    color: var(--muted);
    padding: 0.3rem 0.75rem;
    border-radius: 999px;
    cursor: pointer;
    transition: background 0.2s ease, color 0.2s ease;
  }
  .md-card__switch button.is-active {
    background: var(--ink);
    color: var(--paper);
  }

  .md-card__media {
    background:
      linear-gradient(rgba(20, 19, 15, 0.04) 1px, transparent 1px),
      linear-gradient(90deg, rgba(20, 19, 15, 0.04) 1px, transparent 1px);
    background-size: 28px 28px;
    margin: 0.6rem 0.8rem 0;
    border-radius: var(--radius);
    display: grid;
    min-height: 220px;
    place-items: center;
    padding: 0.8rem;
  }
  .md-card__view { width: 100%; }
  .md-card__view :global(.iso) { filter: drop-shadow(0 16px 20px rgba(20, 19, 15, 0.14)); }
  .md-card__view--plan { padding: 0.4rem 0; }
  .md-card__view :global(.md-plan) { width: 100%; height: auto; display: block; }

  .md-card__body {
    display: flex;
    flex-direction: column;
    flex: 1;
    padding: 1.2rem 1.4rem 1.5rem;
  }
  .md-card__body h3 { margin-bottom: 0.15rem; }
  .md-card__subtitle {
    font-size: 0.85rem;
    color: var(--muted);
    margin-bottom: 0.8rem;
  }
  .md-card__text { font-size: 0.97rem; }

  .md-card__features {
    list-style: none;
    padding: 0;
    margin: 0 0 1.3rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .md-card__actions {
    margin-top: auto;
    display: grid;
    gap: 0.75rem;
  }
  .md-card__cta { justify-content: center; }
  .md-card__calc {
    font-family: var(--font-head);
    font-size: 0.88rem;
    font-weight: 600;
    text-align: center;
    text-decoration: none;
    color: var(--ink-soft);
    border-bottom: 1px solid transparent;
    justify-self: center;
    transition: border-color 0.2s ease;
  }
  .md-card__calc:hover { border-color: var(--ink); }

  @media (max-width: 1000px) {
    .md-grid { grid-template-columns: 1fr; max-width: 560px; margin-inline: auto; }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('.md-card').forEach((card) => {
    const btns = card.querySelectorAll<HTMLButtonElement>('[data-view]');
    const panes = card.querySelectorAll<HTMLElement>('[data-pane]');
    btns.forEach((btn) =>
      btn.addEventListener('click', () => {
        btns.forEach((b) => {
          const on = b === btn;
          b.classList.toggle('is-active', on);
          b.setAttribute('aria-pressed', String(on));
        });
        panes.forEach((p) => (p.hidden = p.dataset.pane !== btn.dataset.view));
      })
    );
  });
</script>
