---
import { principleScene } from '../lib/iso/scenes';

const schritte = [
  {
    nr: '01',
    title: 'Ein Modul ist eine fertige Einheit.',
    text: 'Bad, Küche, Klimaanlage und Wärmepumpe sind ab Werk eingebaut. Das Modul wird komplett geliefert und ist nach dem Anschluss sofort nutzbar.',
    range: '0,0.28',
  },
  {
    nr: '02',
    title: 'Module lassen sich frei kombinieren.',
    text: 'Schlaf-, Wohnraum- und Luxuseinheit nebeneinander — ab 10 Einheiten skalierbar bis zum ganzen Park. Einheit für Einheit, ohne neues Bauprojekt.',
    range: '0.28,0.56',
  },
  {
    nr: '03',
    title: 'Erweiterungen kommen gleich mit.',
    text: 'Terrasse, Pool, Sauna oder Fitness werden gemeinsam mit den Einheiten geliefert — schlüsselfertig, ohne separates Gewerk und ohne zusätzliche Baustelle.',
    range: '0.56,0.8',
  },
  {
    nr: '04',
    title: 'Die Anlage arbeitet für Sie.',
    text: 'Photovoltaik und Speicher senken die Betriebskosten, Wärmepumpe und Klimaanlage machen jede Einheit ganzjährig vermietbar.',
    range: '0.8,1',
  },
];

const tags = [
  '1 Modul · schlüsselfertig',
  '3 Module · frei kombiniert',
  '+ Terrasse · Pool · Sauna',
  '+ PV & Speicher · ganzjährig',
];

const szene = principleScene();
---

<section class="prinzip section--dark" id="prinzip" data-stage>
  <div class="prinzip__sticky">
    <div class="container prinzip__grid">
      <div class="prinzip__copy">
        <span class="section-kicker">Das Prinzip</span>
        <h2>Ein Modul. Beliebig kombiniert. Beliebig erweitert.</h2>

        <ol class="prinzip__steps">
          {schritte.map((s) => (
            <li class="prinzip__step" data-range={s.range}>
              <span class="prinzip__nr">{s.nr}</span>
              <div>
                <h3>{s.title}</h3>
                <p>{s.text}</p>
              </div>
            </li>
          ))}
        </ol>

        <div class="prinzip__cta">
          <a href="#anfrage" class="btn btn--light">Unverbindliches Angebot</a>
          <a href="#rechner" class="btn btn--ghost-light">Rendite berechnen</a>
        </div>
      </div>

      <div class="prinzip__stage">
        <Fragment set:html={szene} />
        <ul class="prinzip__tags" aria-hidden="true">
          {tags.map((t, i) => <li class="prinzip__tag" data-tag={i}>{t}</li>)}
        </ul>
        <div class="prinzip__dots" aria-hidden="true">
          {schritte.map((_, i) => <i data-dot={i}></i>)}
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .prinzip {
    position: relative;
    height: 430vh;
    background:
      radial-gradient(ellipse 60% 60% at 70% 45%, #2a2820 0%, rgba(42, 40, 32, 0) 70%),
      var(--ink);
    color: var(--paper);
  }

  .prinzip__sticky {
    position: sticky;
    top: 0;
    height: 100svh;
    display: flex;
    align-items: center;
    padding-top: 84px;
    overflow: hidden;
  }

  .prinzip :global(.container) { padding-inline: clamp(5%, 6vw, 9%); }

  .prinzip__grid {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.25fr);
    gap: clamp(1.5rem, 4vw, 4rem);
    align-items: center;
  }

  .prinzip h2 {
    font-size: clamp(1.7rem, 3vw, 2.5rem);
    margin-bottom: 1.6rem;
  }
  .prinzip :global(.section-kicker) { color: var(--accent); }

  .prinzip__steps {
    list-style: none;
    margin: 0 0 1.6rem;
    padding: 0;
    display: grid;
    gap: 0.4rem;
  }
  .prinzip__step {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 1rem;
    padding: 0.9rem 0 0.9rem 1rem;
    border-left: 2px solid rgba(255, 255, 255, 0.14);
    opacity: 0.38;
    transition: opacity 0.4s ease, border-color 0.4s ease, background 0.4s ease;
  }
  .prinzip__step h3 { font-size: 1.12rem; margin: 0 0 0.25rem; }
  .prinzip__step p {
    margin: 0;
    font-size: 0.95rem;
    color: rgba(255, 255, 255, 0.72);
    max-height: 0;
    opacity: 0;
    overflow: hidden;
    transition: max-height 0.45s ease, opacity 0.35s ease;
  }
  .prinzip__step.is-on {
    opacity: 1;
    border-color: var(--accent);
    background: linear-gradient(90deg, rgba(200, 169, 110, 0.1), transparent);
  }
  .prinzip__step.is-on p { max-height: 9rem; opacity: 1; }
  .prinzip__nr {
    font-family: var(--font-head);
    font-weight: 800;
    font-size: 0.95rem;
    color: var(--accent);
    padding-top: 0.12rem;
  }

  .prinzip__cta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem;
  }

  .prinzip__stage {
    position: relative;
    height: min(68svh, 640px);
    display: grid;
    place-items: center;
  }
  .prinzip__stage :global(.iso) {
    width: 100%;
    height: 100%;
    filter: drop-shadow(0 30px 50px rgba(0, 0, 0, 0.45));
  }

  .prinzip__tags {
    list-style: none;
    margin: 0;
    padding: 0;
    position: absolute;
    inset: auto 0 0 0;
    height: 2rem;
  }
  .prinzip__tag {
    position: absolute;
    left: 50%;
    bottom: 0;
    white-space: nowrap;
    font-family: var(--font-head);
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--ink);
    background: var(--accent);
    border-radius: 999px;
    padding: 0.4rem 0.95rem;
    opacity: 0;
    transform: translate(-50%, 8px);
    transition: opacity 0.35s ease, transform 0.35s ease;
  }
  .prinzip[data-step='0'] [data-tag='0'],
  .prinzip[data-step='1'] [data-tag='1'],
  .prinzip[data-step='2'] [data-tag='2'],
  .prinzip[data-step='3'] [data-tag='3'] {
    opacity: 1;
    transform: none;
  }

  .prinzip__dots {
    position: absolute;
    right: 0;
    top: 50%;
    transform: translateY(-50%);
    display: grid;
    gap: 0.6rem;
  }
  .prinzip__dots i {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.25);
    transition: background 0.3s ease, transform 0.3s ease;
  }
  .prinzip[data-step='0'] [data-dot='0'],
  .prinzip[data-step='1'] [data-dot='1'],
  .prinzip[data-step='2'] [data-dot='2'],
  .prinzip[data-step='3'] [data-dot='3'] {
    background: var(--accent);
    transform: scale(1.5);
  }

  /* Tablet/Mobil: Szene oben, Text darunter. Alle Schritte liegen übereinander
     in einer Grid-Zelle und blenden weich über — so ändert sich beim Scrollen
     nie die Höhe, und nichts springt. */
  @media (max-width: 900px) {
    .prinzip { height: 400vh; }
    .prinzip__sticky { padding-top: 76px; align-items: flex-start; }
    .prinzip__grid { grid-template-columns: 1fr; gap: 0.5rem; }
    .prinzip__stage { order: -1; height: 44svh; contain: layout paint; }
    /* Der Schlagschatten wäre bei jedem Frame der Animation neu zu rechnen */
    .prinzip__stage :global(.iso) { filter: none; }
    .prinzip h2 { font-size: 1.35rem; margin-bottom: 0.7rem; }
    .prinzip :global(.section-kicker) { margin-bottom: 0.4rem; }
    .prinzip__steps { gap: 0; margin-bottom: 0; }
    .prinzip__step {
      grid-area: 1 / 1;
      align-content: start;
      padding: 0.55rem 0 0.55rem 0.8rem;
      visibility: hidden;
      opacity: 0;
      transform: translateY(10px);
      transition: opacity 0.45s ease, transform 0.45s ease, visibility 0s linear 0.45s;
    }
    .prinzip__step.is-on {
      visibility: visible;
      transform: none;
      transition: opacity 0.45s ease 0.08s, transform 0.45s ease 0.08s, visibility 0s;
    }
    .prinzip__step p { max-height: none; opacity: 1; transition: none; }
    .prinzip__step h3 { font-size: 1.02rem; }
    .prinzip__cta { display: none; }
    .prinzip__dots { right: 4px; top: 4px; bottom: auto; flex-direction: row; display: flex; transform: none; }
    .prinzip__tag { font-size: 0.7rem; padding: 0.3rem 0.7rem; }
  }

  /* Reduzierte Bewegung: keine Scroll-Bühne, alles untereinander */
  .prinzip.is-static { height: auto; }
  .prinzip.is-static .prinzip__sticky { position: static; height: auto; padding-block: 5rem; }
  .prinzip.is-static .prinzip__step { opacity: 1; }
  .prinzip.is-static .prinzip__step p { max-height: none; opacity: 1; }
  .prinzip.is-static .prinzip__steps { display: grid; gap: 0.4rem; }
  .prinzip.is-static .prinzip__step { grid-area: auto; visibility: visible; transform: none; }
  .prinzip.is-static .prinzip__tags,
  .prinzip.is-static .prinzip__dots { display: none; }
</style>
