    display: grid;
    gap: 0.55rem;
  }
  .rc__rows div {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    font-size: 0.93rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    padding-bottom: 0.55rem;
  }
  .rc__rows dt { color: rgba(255, 255, 255, 0.62); }
  .rc__rows dd {
    margin: 0;
    font-family: var(--font-head);
    font-weight: 600;
    white-space: nowrap;
