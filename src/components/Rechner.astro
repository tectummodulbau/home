  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }

  .rc__chart { margin: 0 0 1.3rem; }
  .rc__chart figcaption {
    font-family: var(--font-head);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.5);
    margin-bottom: 0.4rem;
  }
  .rc__chart svg { width: 100%; height: auto; display: block; overflow: visible; }
  .rc__chart :global(.ch-line) { transition: d 0.45s ease; }
  .rc__chart :global(.ch-label) {
    font-family: var(--font-head);
    font-size: 9px;
    font-weight: 700;
    fill: rgba(255, 255, 255, 0.55);
  }
  .rc__chart :global(.ch-be) { animation: rc-be 2s ease-out infinite; transform-box: fill-box; transform-origin: center; }
  @keyframes rc-be { 0% { box-shadow: none; opacity: 1; } 70%, 100% { opacity: 0.25; } }

  .rc__slider { margin-bottom: 1.35rem; }
  .rc__slider:last-child { margin-bottom: 0; }

  .rc__slider-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: 0.5rem;
  }
  .rc__slider-head label {
    font-family: var(--font-head);
    font-weight: 600;
    font-size: 0.95rem;
  }
  .rc__slider-head output {
    font-family: var(--font-head);
    font-weight: 800;
    font-size: 1.05rem;
  }

  .rc__slider input[type='range'] {
    -webkit-appearance: none;
    appearance: none;
    width: 100%;
    height: 6px;
    border-radius: 999px;
    background: linear-gradient(to right, var(--ink) 0%, var(--sand) 0%);
    outline: none;
    cursor: pointer;
  }
  .rc__slider input[type='range']::-webkit-slider-thumb {
    -webkit-appearance: none;
    appearance: none;
    width: 22px;
    height: 22px;
    border-radius: 50%;
    background: var(--ink);
    border: 3px solid var(--paper);
    box-shadow: 0 1px 6px rgba(20, 19, 15, 0.35);
  }
  .rc__slider input[type='range']::-moz-range-thumb {
    width: 16px;
    height: 16px;
    border-radius: 50%;
    background: var(--ink);
    border: 3px solid var(--paper);
    box-shadow: 0 1px 6px rgba(20, 19, 15, 0.35);
  }

  .rc__hint {
    font-size: 0.83rem;
    color: var(--muted);
    margin: 0.45rem 0 0;
  }

  .rc__results {
    background: var(--ink);
    color: var(--paper);
    border-radius: var(--radius-lg);
    padding: clamp(1.4rem, 3vw, 2.2rem);
    display: flex;
    flex-direction: column;
  }

  .rc__results-label {
    font-family: var(--font-head);
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.6);
    margin-bottom: 0.3rem;
  }

  .rc__netto {
    font-family: var(--font-head);
    font-size: clamp(2.2rem, 4vw, 3rem);
