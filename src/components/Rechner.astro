  .rc__cta {
    margin-top: auto;
    justify-content: center;
  }

  @media (max-width: 860px) {
    .rc { grid-template-columns: 1fr; }
  }
</style>

<script>
  import { createDebouncedTracker, trackOnce } from '../lib/analytics/tracker';

  // Werte und Formel entsprechen dem Rechner der Original-Seite
  const VARIANTS: Record<string, { leasing: number; preisDefault: number; chips: string[] }> = {
    schlaf: { leasing: 9600, preisDefault: 95, chips: ['2 Schlafzimmer', '4 Betten', 'Vollbad', 'Klimaanlage', 'Wärmepumpe'] },
    family: { leasing: 12000, preisDefault: 120, chips: ['Küche', 'Wohnbereich', 'Schlafbereich', 'Vollbad', 'Klimaanlage', 'Wärmepumpe'] },
    luxus: { leasing: 15600, preisDefault: 175, chips: ['Erweiterte Fläche', 'Premium-Küche', 'Wohnbereich', 'Schlafbereich', 'Vollbad', 'Klimaanlage'] },
  };

  let variant = 'schlaf';

  /** Angezeigter Netto-Wert (für die Zahlen-Animation). */
  let angezeigt = 0;
  let tweenId = 0;
  let srTimer: number | undefined;

  /**
   * Zuletzt berechneter Netto-Mehrertrag. `update()` schreibt ihn mit, damit
   * calculator_configured die Formel nicht ein zweites Mal nachbauen muss.
   */
  let letzterMehrertrag = 0;

  /**
   * Wird nach 2 Sekunden ohne weitere Interaktion gefeuert. Ohne die Bremse
   * würde jede Slider-Bewegung ein eigenes Event erzeugen.
   */
  const meldeKonfiguration = createDebouncedTracker('calculator_configured', 2000);

  function meldeInteraktion() {
    trackOnce('calculator_interact', 'calculator_interact');
    meldeKonfiguration(() => ({
      // Beschriftung des aktiven Tabs statt des internen Schlüssels — im
      // Report lesbar und immer synchron mit der Oberfläche.
      modultyp: document.querySelector('.rc__tab.is-active')?.textContent ?? variant,
      anzahl_einheiten: +input('rc-module').value,
      auslastung: +input('rc-auslastung').value,
      preis_pro_nacht: +input('rc-preis').value,
      berechneter_mehrertrag: letzterMehrertrag,
    }));
  }

  const $ = (id: string) => document.getElementById(id) as HTMLElement;
  const input = (id: string) => document.getElementById(id) as HTMLInputElement;

  const fmt = (n: number) => Math.abs(Math.round(n)).toLocaleString('de-DE') + ' €';
  const fmtSign = (n: number) => (n >= 0 ? '+' : '−') + fmt(n);

  function renderChips() {
    $('rc-chips').innerHTML = VARIANTS[variant].chips
      .map((c) => `<span class="chip">${c}</span>`)
      .join('');
  }

  function paintTrack(el: HTMLInputElement) {
    const p = ((+el.value - +el.min) / (+el.max - +el.min)) * 100;
    el.style.background = `linear-gradient(to right, var(--ink) ${p}%, var(--sand) ${p}%)`;
  }

  function update() {
    const mod = +input('rc-module').value;
    const aus = +input('rc-auslastung').value / 100;
    const prs = +input('rc-preis').value;
    const heu = +input('rc-heute').value;
    const v = VARIANTS[variant];

    $('rc-val-module').textContent = String(mod);
    $('rc-val-auslastung').textContent = Math.round(aus * 100) + ' %';
    $('rc-val-preis').textContent = prs + ' €';
    $('rc-val-heute').textContent = heu.toLocaleString('de-DE') + ' €';

    const umsatz = 365 * aus * prs * mod;
    const leasing = v.leasing * mod;
    const betrieb = umsatz * 0.25;
    const netto = umsatz - leasing - betrieb - heu;

    letzterMehrertrag = netto;

    const nettoEl = $('rc-netto');
    zeigeNetto(netto);
    nettoEl.classList.toggle('is-negative', netto < 0);
    $('rc-pro-einheit').textContent = fmtSign(netto / mod);

    $('rc-umsatz').textContent = '+' + fmt(umsatz);
    $('rc-leasing').textContent = '−' + fmt(leasing);
    $('rc-betrieb').textContent = '−' + fmt(betrieb);
    $('rc-heute-res').textContent = '−' + fmt(heu);

    const inv = leasing * 7;
    let years: number | null = null;
    if (netto > 0) {
      years = inv / netto;
      $('rc-roi').textContent =
        years < 1 ? '< 1 Jahr' : Math.ceil(years) + (Math.ceil(years) === 1 ? ' Jahr' : ' Jahre');
    } else {
      $('rc-roi').textContent = '–';
    }
    $('rc-roi-badge').classList.toggle('is-good', years !== null && years < 8);

    ['rc-module', 'rc-auslastung', 'rc-preis', 'rc-heute'].forEach((id) => paintTrack(input(id)));
    zeichneChart(netto, inv, years);

    const aktiv = presetFor(Math.round(aus * 100), prs);
    document.querySelectorAll<HTMLElement>('.rc__preset').forEach((b) => b.classList.toggle('is-active', b === aktiv));
  }

  /** Zahl weich zum neuen Wert laufen lassen. */
  function zeigeNetto(ziel: number) {
    cancelAnimationFrame(tweenId);
    const von = angezeigt;
    const t0 = performance.now();
    const reduziert = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const el = $('rc-netto');
    const schritt = (jetzt: number) => {
      const t = reduziert ? 1 : Math.min(1, (jetzt - t0) / 450);
      const e = 1 - Math.pow(1 - t, 3);
      angezeigt = von + (ziel - von) * e;
      el.textContent = fmtSign(angezeigt);
      if (t < 1) tweenId = requestAnimationFrame(schritt);
      else angezeigt = ziel;
    };
    tweenId = requestAnimationFrame(schritt);
    // Screenreader bekommt nur den Endwert, nicht jeden Zwischenschritt.
    clearTimeout(srTimer);
    srTimer = window.setTimeout(() => {
      $('rc-netto-sr').textContent = `Netto-Mehrertrag ${fmtSign(ziel)} pro Jahr`;
    }, 700);
  }

  /** Kumulierter Mehrertrag vs. Investition, 10 Jahre. */
  function zeichneChart(netto: number, inv: number, years: number | null) {
    const W = 320, H = 150, L = 6, R = 10, T = 14, B = 22;
    const jahre = 10;
    const werte = [0, inv, netto * jahre];
    const max = Math.max(...werte, 1) * 1.08;
    const min = Math.min(...werte, 0);
    const x = (j: number) => L + ((W - L - R) * j) / jahre;
    const y = (v: number) => T + ((H - T - B) * (max - v)) / (max - min);
    const end = netto * jahre;
    const linie = `M${x(0)} ${y(0)} L${x(jahre)} ${y(end)}`;
    const flaeche = `${linie} L${x(jahre)} ${y(0)} Z`;
    let svg = `<defs><linearGradient id="rc-grad" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#c8a96e" stop-opacity=".45"/><stop offset="1" stop-color="#c8a96e" stop-opacity="0"/></linearGradient></defs>`;
    svg += `<path d="M${L} ${y(0)} H${W - R}" stroke="rgba(255,255,255,.18)" stroke-width="1"/>`;
    for (let j = 0; j <= jahre; j += 2) svg += `<text class="ch-label" x="${x(j)}" y="${H - 6}" text-anchor="middle">${j === 0 ? 'Start' : 'J' + j}</text>`;
    if (netto > 0) svg += `<path d="${flaeche}" fill="url(#rc-grad)"/>`;
    svg += `<path d="M${L} ${y(inv)} H${W - R}" stroke="#e08a7a" stroke-width="1.3" stroke-dasharray="4 4"/>`;
    svg += `<text class="ch-label" x="${W - R}" y="${y(inv) - 4}" text-anchor="end" fill="#e08a7a" style="fill:#e08a7a">Investition</text>`;
    svg += `<path class="ch-line" d="${linie}" fill="none" stroke="${netto >= 0 ? '#c8a96e' : '#e08a7a'}" stroke-width="2.5" stroke-linecap="round"/>`;
    if (years !== null && years <= jahre) {
      svg += `<circle class="ch-be" cx="${x(years)}" cy="${y(inv)}" r="9" fill="#c8a96e" opacity=".3"/><circle cx="${x(years)}" cy="${y(inv)}" r="4.5" fill="#c8a96e" stroke="#14130f" stroke-width="2"/>`;
      svg += `<text class="ch-label" x="${Math.min(x(years), W - 26)}" y="${y(inv) + 16}" text-anchor="middle" style="fill:#fff">Break-even ~J${Math.ceil(years)}</text>`;
    }
    $('rc-chart').innerHTML = svg;
  }

  /** Welches Szenario passt zu den aktuellen Reglern? */
  function presetFor(aus: number, prs: number): HTMLElement | null {
    for (const b of document.querySelectorAll<HTMLElement>('.rc__preset')) {
      const p = b.dataset.preis ? +b.dataset.preis : VARIANTS[variant].preisDefault;
      if (+b.dataset.aus! === aus && p === prs) return b;
    }
    return null;
  }

  function waehleVariante(key: string) {
    variant = key in VARIANTS ? key : 'schlaf';
    document.querySelectorAll<HTMLElement>('.rc__tab').forEach((t) => {
      const on = t.dataset.variant === variant;
      t.classList.toggle('is-active', on);
      t.setAttribute('aria-selected', String(on));
    });
    input('rc-preis').value = String(VARIANTS[variant].preisDefault);
    renderChips();
    update();
  }

  document.querySelectorAll<HTMLButtonElement>('.rc__tab').forEach((tab) => {
    tab.addEventListener('click', () => {
      waehleVariante(tab.dataset.variant ?? 'schlaf');
      meldeInteraktion();
    });
  });

  // Szenarien setzen Auslastung und Preis in einem Schritt
  document.querySelectorAll<HTMLButtonElement>('.rc__preset').forEach((b) =>
    b.addEventListener('click', () => {
      input('rc-auslastung').value = b.dataset.aus ?? '60';
      input('rc-preis').value = b.dataset.preis || String(VARIANTS[variant].preisDefault);
      update();
      meldeInteraktion();
    })
  );

  // „Ertrag mit dieser Einheit rechnen" aus den Modulkarten: Variante vorwählen.
  // Bewusst kein Tracking — das ist Navigation, keine Rechner-Interaktion.
  document.querySelectorAll<HTMLAnchorElement>('[data-calc-variant]').forEach((a) =>
    a.addEventListener('click', () => waehleVariante(a.dataset.calcVariant ?? 'schlaf'))
  );

  // Rechner-CTA: gewählte Größenordnung im Anfrageformular vorbelegen.
  document.querySelector<HTMLAnchorElement>('.rc__cta')?.addEventListener('click', () => {
    const sel = document.getElementById('lf-einheiten') as HTMLSelectElement | null;
    if (!sel) return;
    const n = +input('rc-module').value;
    const ziel = n <= 20 ? '10 bis 20 Einheiten' : '21 bis 50 Einheiten';
    if ([...sel.options].some((o) => o.value === ziel)) {
      sel.value = ziel;
      sel.dispatchEvent(new Event('change', { bubbles: true }));
    }
  });

  ['rc-module', 'rc-auslastung', 'rc-preis', 'rc-heute'].forEach((id) =>
    input(id).addEventListener('input', () => {
      update();
      meldeInteraktion();
    })
  );

  renderChips();
  update();
</script>
