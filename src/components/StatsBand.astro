---
// Kennzahlen-Band direkt unter den Grundmodulen
const stats = [
  { prefix: '', value: 'GEG', count: null, decimals: 0, suffix: '', label: 'Bauweise nach den Anforderungen des Gebäudeenergiegesetzes' },
  { prefix: '< ', value: '0,20', count: 0.2, decimals: 2, suffix: '', label: 'U-Wert in W/(m²·K) — Dämmung auf Passivhaus-Niveau' },
  { prefix: '', value: 'Wochen', count: null, decimals: 0, suffix: '', label: 'Lieferung ab Werk statt 12–24 Monate Bauzeit' },
  { prefix: '', value: '365', count: 365, decimals: 0, suffix: ' Tage', label: 'Ganzjahresbetrieb dank Wärmepumpe und Klimaanlage' },
];
---

<section class="section section--dark stats-band">
  <div class="container stats-band__grid">
    {stats.map((s) => (
      <div class="stats-band__item reveal">
        <strong>
          {s.prefix}
          {s.count !== null ? <span data-count={s.count} data-decimals={s.decimals}>{s.value}</span> : s.value}
          {s.suffix}
        </strong>
        <span>{s.label}</span>
      </div>
    ))}
  </div>
</section>

<style>
  .stats-band { padding-block: clamp(2.8rem, 6vw, 4.5rem) clamp(2rem, 4vw, 3rem); }

  .stats-band__grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: clamp(1.5rem, 4vw, 3rem);
  }

  .stats-band__item {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    padding-left: 1.2rem;
    border-left: 2px solid var(--accent);
  }

  .stats-band__item strong {
    font-family: var(--font-head);
    font-size: clamp(1.7rem, 3vw, 2.3rem);
    font-weight: 800;
    letter-spacing: -0.02em;
    color: var(--accent);
    white-space: pre;
  }

  .stats-band__item span {
    font-size: 0.92rem;
    color: rgba(255, 255, 255, 0.68);
  }

  @media (max-width: 920px) {
    .stats-band__grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 520px) {
    .stats-band__grid { grid-template-columns: 1fr; }
  }
</style>
