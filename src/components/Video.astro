---
// Imagefilm — bewusst nicht mehr im Hero. Das Video wird erst nach dem Klick
// geladen (preload="none"), spart Bandbreite und gibt dem Nutzer den Ton frei.
const punkte = [
  'Ein Modul aus der Nähe: Fassade, Glasfront, Terrasse',
  'Wie schlüsselfertig wirklich aussieht',
  'Was Sie bei Lieferung und Aufstellung erwartet',
];
---

<section class="section section--stone vd" id="video" data-stage>
  <div class="vd__sticky">
    <div class="container vd__container">
      <div class="vd__head">
        <span class="section-kicker">Im Film</span>
        <h2>Sehen Sie, was Sie bekommen.</h2>
        <ul class="vd__list">
          {punkte.map((p) => (
            <li>
              <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5" /></svg>
              {p}
            </li>
          ))}
        </ul>
      </div>

      <div class="vd__frame" id="vd-frame">
        <video
          id="vd-video"
          class="vd__video"
          poster="/video/hero-film-poster.jpg"
          preload="none"
          playsinline
          controls
          hidden
          aria-label="Tectum Moduleinheit — Imagefilm mit Martin Horst"
        >
          <source src="/video/hero-film.mp4" type="video/mp4" />
        </video>

        <button type="button" class="vd__play" id="vd-play" aria-label="Imagefilm abspielen">
          <img src="/video/hero-film-poster.jpg" alt="Imagefilm von Tectum Modulbau: schlüsselfertige Moduleinheit mit Martin Horst" title="Imagefilm abspielen" loading="lazy" width="1280" height="720" />
          <span class="vd__play-btn" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="30" height="30" fill="currentColor"><path d="M8 5.2v13.6L19 12 8 5.2Z" /></svg>
          </span>
          <span class="vd__play-label">Film ansehen · Martin Horst, Tectum Modulbau</span>
        </button>
      </div>
    </div>
  </div>
</section>

<style>
  .vd { height: 190vh; padding: 0; position: relative; }
  .vd__sticky {
    position: sticky;
    top: 0;
    height: 100svh;
    display: flex;
    align-items: center;
    padding-top: 80px;
  }
  .vd__container {
    padding-inline: clamp(4%, 5vw, 8%);
    display: grid;
    grid-template-columns: minmax(0, 0.42fr) minmax(0, 1.58fr);
    gap: clamp(1.5rem, 4vw, 3.5rem);
    align-items: center;
  }

  .vd__head { opacity: calc(1 - var(--p, 0) * 0.0); }
  .vd h2 { font-size: clamp(1.7rem, 3vw, 2.5rem); }
  .vd__list {
    list-style: none;
    margin: 1.4rem 0 0;
    padding: 0;
    display: grid;
    gap: 0.8rem;
  }
  .vd__list li {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.7rem;
    align-items: start;
    font-size: 0.98rem;
  }
  .vd__list svg { color: var(--green); margin-top: 0.2rem; }

  /* Scroll-Effekt: Rahmen wächst von klein auf voll und rundet sich ab */
  .vd__frame {
    --k: clamp(0, calc(var(--p, 1) * 2.4), 1);
    position: relative;
    aspect-ratio: 16 / 9;
    background: var(--ink);
    border-radius: calc(46px - 24px * var(--k));
    overflow: hidden;
    box-shadow: 0 calc(10px + 30px * var(--k)) calc(20px + 50px * var(--k)) rgba(20, 19, 15, 0.28);
    transform: scale(calc(0.8 + 0.2 * var(--k)));
    will-change: transform;
  }
  .vd__video,
  .vd__play { position: absolute; inset: 0; width: 100%; height: 100%; }
  .vd__video { object-fit: contain; background: #000; }
  .vd__play {
    border: 0;
    padding: 0;
    cursor: pointer;
    background: var(--ink);
    display: block;
  }
  .vd__play img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.8s ease; }
  .vd__play:hover img { transform: scale(1.04); }
  .vd__play::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(20, 19, 15, 0.05) 40%, rgba(20, 19, 15, 0.65) 100%);
  }
  .vd__play-btn {
    position: absolute;
    z-index: 1;
    left: 50%;
    top: 50%;
    width: 92px;
    height: 92px;
    margin: -46px 0 0 -46px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    color: var(--ink);
    background: var(--accent);
    box-shadow: 0 0 0 0 rgba(200, 169, 110, 0.6);
    animation: vd-pulse 2.4s ease-out infinite;
    transition: transform 0.25s ease;
  }
  .vd__play-btn svg { margin-left: 4px; }
  .vd__play:hover .vd__play-btn { transform: scale(1.08); }
  @keyframes vd-pulse { to { box-shadow: 0 0 0 26px rgba(200, 169, 110, 0); } }
  .vd__play-label {
    position: absolute;
    z-index: 1;
    left: 1.2rem;
    bottom: 1rem;
    font-family: var(--font-head);
    font-weight: 700;
    font-size: 0.92rem;
    color: #fff;
  }
  .vd__play:focus-visible { outline: 3px solid var(--accent); outline-offset: -3px; }

  @media (max-width: 900px) {
    .vd { height: auto; padding-block: clamp(3.5rem, 9vw, 5rem); }
    .vd__sticky { position: static; height: auto; padding-top: 0; }
    .vd__container { grid-template-columns: 1fr; }
    .vd__frame { transform: none; border-radius: 18px; --k: 1; }
    .vd__play-btn { width: 72px; height: 72px; margin: -36px 0 0 -36px; }
  }
  .vd.is-static { height: auto; padding-block: 5rem; }
  .vd.is-static .vd__sticky { position: static; height: auto; padding-top: 0; }
  .vd.is-static .vd__frame { transform: none; --k: 1; }
</style>

<script>
  import { trackOnce } from '../lib/analytics/tracker';

  const video = document.getElementById('vd-video') as HTMLVideoElement | null;
  const play = document.getElementById('vd-play') as HTMLButtonElement | null;

  play?.addEventListener('click', () => {
    if (!video) return;
    video.hidden = false;
    play.hidden = true;
    video.play().catch(() => {
      // Autoplay-Sperre o. Ä.: Nutzer kann über die Steuerelemente starten.
    });
    // Nur der nutzerinitiierte Klick zählt — das Video startet nie von selbst.
    trackOnce('video_play', 'video_play');
  });
</script>
