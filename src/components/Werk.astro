---
import { werkFrameScene, werkQualityScene, werkTruckScene } from '../lib/iso/scenes';

const stationen = [
  {
    nr: '01',
    title: 'Vorfertigung im Werk',
    text: 'CNC-gesteuerte Fertigung in unserer eigenen Werkstatt — witterungsunabhängig und in gleichbleibender Qualität.',
    svg: werkFrameScene(),
  },
  {
    nr: '02',
    title: 'Qualitätskontrolle',
    text: 'Jede Einheit durchläuft eine geprüfte Endabnahme nach DGNB- und TÜV-Standard, bevor sie das Werk verlässt.',
    svg: werkQualityScene(),
  },
  {
    nr: '03',
    title: 'Lieferung ab Werk',
    text: 'Schlüsselfertiger Transport direkt zu Ihrem Standort — keine klassische Baustelle, keine Wartezeit vor Ort.',
    svg: werkTruckScene(),
  },
];
---

<section class="section section--dark werk" id="werk">
  <div class="container werk__container">
    <div class="section-head section-head--center reveal">
      <span class="section-kicker">Unser Werk</span>
      <h2>Gebaut im Werk. Nicht auf der Baustelle.</h2>
      <p class="section-lead">
        Alle Tectum Module entstehen in unserer eigenen Fertigung — witterungsunabhängig,
        DGNB-zertifiziert und in konstanter Qualität, bevor sie schlüsselfertig zu Ihnen
        geliefert werden.
      </p>
    </div>

    <ol class="werk__grid">
      {stationen.map((s, i) => (
        <li class="werk__card reveal" style={`--i:${i}`}>
          <div class="werk__scene"><Fragment set:html={s.svg} /></div>
          <div class="werk__body">
            <span class="werk__nr">{s.nr}</span>
            <h3>{s.title}</h3>
            <p>{s.text}</p>
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .werk__container { padding-inline: clamp(5%, 8vw, 12%); }

  .werk__grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(1rem, 2vw, 1.6rem);
    counter-reset: none;
  }

  .werk__card {
    background: linear-gradient(180deg, #211f19 0%, #1a1914 100%);
    border: 1px solid rgba(255, 255, 255, 0.09);
    border-radius: var(--radius-lg);
    overflow: hidden;
    position: relative;
  }
  /* Verbindungslinie zwischen den Stationen */
  .werk__card:not(:last-child)::after {
    content: '';
    position: absolute;
    top: 38%;
    right: -1.3rem;
    width: 1.6rem;
    height: 2px;
    background: repeating-linear-gradient(90deg, var(--accent) 0 6px, transparent 6px 11px);
    z-index: 2;
  }

  .werk__scene {
    padding: 1rem 1rem 0;
    background: radial-gradient(ellipse 70% 70% at 50% 60%, rgba(200, 169, 110, 0.14), transparent 70%);
  }
  .werk__scene { position: relative; height: clamp(230px, 21vw, 290px); }
  .werk__scene :global(.iso) { position: absolute; inset: 1rem 1rem 0; width: calc(100% - 2rem); height: calc(100% - 1rem); filter: drop-shadow(0 14px 18px rgba(0, 0, 0, 0.5)); }

  .werk__body { padding: 0.4rem 1.5rem 1.7rem; }
  .werk__nr {
    font-family: var(--font-head);
    font-weight: 800;
    font-size: 0.85rem;
    letter-spacing: 0.14em;
    color: var(--accent);
  }
  .werk__body h3 { margin: 0.3rem 0 0.5rem; }
  .werk__body p { margin: 0; color: rgba(255, 255, 255, 0.72); font-size: 0.97rem; }

  @media (max-width: 960px) {
    .werk__grid { grid-template-columns: 1fr; max-width: 560px; margin-inline: auto; }
    .werk__scene { height: clamp(220px, 58vw, 320px); }
    .werk__card:not(:last-child)::after { display: none; }
  }
</style>
