---
import { zielScene, type ZielKind } from '../lib/iso/scenes';

const gruppen: { kind: ZielKind; title: string; text: string }[] = [
  {
    kind: 'camping',
    title: 'Campingplatz­betreiber',
    text: 'Individuell konfigurierte Camping- und Glamping-Units für Ihren Betrieb — ganzjährig nutzbar, anders als klassische Mobilheime. Auf Wunsch mit Sauna, Fitness oder Loungebereich.',
  },
  {
    kind: 'wohnpark',
    title: 'Wohnparks & Freizeitparks',
    text: 'Schlaf-, Wohn- und Luxuseinheiten für den Dauerbetrieb. Erweiterbar. Ertragsstark.',
  },
  {
    kind: 'kommune',
    title: 'Kommunen & Arbeitgeber',
    text: 'Funktionale Einheiten für temporäre oder dauerhafte Nutzung. Flexibel auf- und abbaubar.',
  },
  {
    kind: 'messe',
    title: 'Messen & Ausstellungen',
    text: 'Repräsentative Einheiten für temporäre oder dauerhafte Präsenz, flexibel aufstellbar und wieder abbaubar.',
  },
];
---

<section class="section section--dark" id="zielgruppen">
  <div class="container zg__container">
    <div class="section-head section-head--center reveal">
      <span class="section-kicker">Einsatzbereiche</span>
      <h2>Ihr Projekt. Unsere Einheiten. Fertig geliefert.</h2>
      <p class="section-lead">
        Ob Campingplatz, Wohnpark, kommunale Unterkunft oder Messeauftritt: Tectum liefert
        skalierbare Modulhäuser, die sich exakt an Ihren Bedarf anpassen. Kein langer
        Planungsvorlauf. Keine Baustelle im klassischen Sinne. Fertig ab Werk.
      </p>
    </div>

    <div class="zg-grid">
      {gruppen.map((g, i) => (
        <article class="zg-card iso-card reveal" style={`--i:${i}`}>
          <div class="zg-card__media"><Fragment set:html={zielScene(g.kind)} /></div>
          <div class="zg-card__body">
            <h3>{g.title}</h3>
            <p>{g.text}</p>
            <a href="#anfrage" class="zg-card__link">Projekt anfragen <span aria-hidden="true">→</span></a>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .zg__container { padding-inline: clamp(5%, 8vw, 12%); }

  .zg-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(1rem, 2vw, 1.6rem);
  }

  .zg-card {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
    align-items: center;
    gap: 0.4rem;
    background: linear-gradient(135deg, #22201a 0%, #1a1914 100%);
    border: 1px solid rgba(255, 255, 255, 0.09);
    border-radius: var(--radius-lg);
    overflow: hidden;
    transition: border-color 0.3s ease, transform 0.65s ease, opacity 0.65s ease;
  }
  .zg-card:hover { border-color: var(--accent); }

  .zg-card__media {
    padding: 0.8rem 0 0.8rem 0.8rem;
    background: radial-gradient(ellipse 70% 70% at 50% 60%, rgba(200, 169, 110, 0.16), transparent 70%);
  }
  .zg-card__media :global(.iso) { filter: drop-shadow(0 14px 16px rgba(0, 0, 0, 0.5)); }

  .zg-card__body { padding: 1.4rem 1.5rem 1.4rem 0.4rem; }
  .zg-card__body h3 { font-size: 1.2rem; margin-bottom: 0.5rem; }
  .zg-card__body p { font-size: 0.94rem; color: rgba(255, 255, 255, 0.72); margin-bottom: 1rem; }

  .zg-card__link {
    font-family: var(--font-head);
    font-weight: 700;
    font-size: 0.92rem;
    text-decoration: none;
    color: var(--accent);
  }
  .zg-card__link span { display: inline-block; transition: transform 0.2s ease; }
  .zg-card__link:hover span { transform: translateX(4px); }

  @media (max-width: 1100px) {
    .zg-grid { grid-template-columns: 1fr; }
  }
  @media (max-width: 560px) {
    .zg-card { grid-template-columns: 1fr; }
    .zg-card__media { padding: 0.8rem 0.8rem 0; }
    .zg-card__body { padding: 0.6rem 1.3rem 1.5rem; }
  }
</style>
