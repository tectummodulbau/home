---
// Consent-Banner: bewusst schlicht. Kurzer Text, drei gleichwertige Aktionen;
// die Auswahl einzelner Kategorien liegt im Einstellungsdialog (Link
// „Einstellungen", [data-privacy-settings-trigger]). Wird beim ersten Besuch
// bzw. bei ungültiger Entscheidung vom Consent-Manager eingeblendet.
---

<div
  id="tectum-consent-banner"
  class="cb"
  role="dialog"
  aria-modal="false"
  aria-labelledby="cb-title"
  aria-describedby="cb-desc"
  hidden
>
  <p class="cb__text">
    <strong id="cb-title">Datenschutz</strong>
    <span id="cb-desc">
      Wir nutzen Statistik nur mit Ihrer Zustimmung. Notwendige Funktionen sind immer aktiv.
      <a href="/datenschutz/">Mehr erfahren</a>
    </span>
  </p>
  <div class="cb__actions">
    <button type="button" class="cb__btn" id="cb-reject-all">Ablehnen</button>
    <button type="button" class="cb__btn" data-privacy-settings-trigger>Einstellungen</button>
    <button type="button" class="cb__btn cb__btn--primary" id="cb-accept-all">Akzeptieren</button>
  </div>
</div>

<style>
  .cb {
    position: fixed;
    left: 0.75rem;
    right: 0.75rem;
    bottom: max(0.75rem, env(safe-area-inset-bottom));
    z-index: 160;
    margin-inline: auto;
    max-width: 440px;
    padding: 0.9rem 1rem;
    display: grid;
    gap: 0.75rem;
    background: rgba(255, 255, 255, 0.96);
    -webkit-backdrop-filter: blur(10px);
    backdrop-filter: blur(10px);
    border: 1px solid var(--line);
    border-radius: 14px;
    box-shadow: 0 10px 30px rgba(20, 19, 15, 0.14);
  }
  .cb[hidden] { display: none; }

  .cb__text {
    margin: 0;
    font-size: 0.8rem;
    line-height: 1.45;
    color: var(--ink-soft);
  }
  .cb__text strong {
    display: block;
    margin-bottom: 0.1rem;
    font-family: var(--font-head);
    font-size: 0.88rem;
    color: var(--ink);
  }
  .cb__text a { color: inherit; text-decoration: underline; text-underline-offset: 2px; }
  .cb__text a:hover { color: var(--ink); }

  .cb__actions {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
    gap: 0.4rem;
  }
  .cb__btn {
    font: inherit;
    font-family: var(--font-head);
    font-size: 0.78rem;
    font-weight: 600;
    padding: 0.55rem 0.4rem;
    border-radius: 999px;
    border: 1px solid var(--line);
    background: transparent;
    color: var(--ink);
    cursor: pointer;
    transition: background 0.15s ease, border-color 0.15s ease;
  }
  .cb__btn:hover { border-color: var(--ink); }
  .cb__btn:focus-visible { outline: 2px solid var(--ink); outline-offset: 2px; }
  .cb__btn--primary { background: var(--ink); border-color: var(--ink); color: var(--paper); }
  .cb__btn--primary:hover { background: #000; }

  @media (min-width: 640px) {
    .cb {
      left: auto;
      right: max(1.25rem, env(safe-area-inset-right));
      bottom: max(1.25rem, env(safe-area-inset-bottom));
      margin-inline: 0;
      width: 400px;
    }
  }
</style>
