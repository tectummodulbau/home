---
// Consent-Banner als kompaktes Aufpop-Widget (Desktop unten mittig, mobil
// schmale Karte unter 40 % der Höhe): Marke, Überschrift, Erläuterung, zwei
// gleichwertige Buttons (Alles akzeptieren / Alles ablehnen) und Links. Die Feinauswahl liegt im Einstellungsdialog.
// Wird vom Consent-Manager eingeblendet, sonst per hidden ausgeblendet.
---

<div
  id="tectum-consent-banner"
  class="cb"
  role="dialog"
  aria-modal="false"
  aria-labelledby="cb-title"
  aria-describedby="cb-desc"
  hidden
>
  <div class="cb__inner">
    <p class="cb__brand" aria-hidden="true">Tectum <em>Modulbau</em></p>
    <h2 id="cb-title" class="cb__title">Wir nutzen Cookies.</h2>
    <p id="cb-desc" class="cb__text">
      Notwendige Cookies sind immer aktiv. Statistik, Marketing und externe Inhalte nur mit
      Ihrer Einwilligung, jederzeit widerrufbar. Details in der Datenschutzerklärung.
    </p>

    <div class="cb__actions">
      <button type="button" class="cb__btn" id="cb-accept-all">Alles akzeptieren</button>
      <button type="button" class="cb__btn" id="cb-reject-all">Alles ablehnen</button>
    </div>

    <nav class="cb__links" aria-label="Rechtliches">
      <a href="/impressum/">Impressum</a>
      <a href="/datenschutz/">Datenschutz</a>
      <a href="#" data-privacy-settings-trigger>Einstellungen</a>
      <a class="cb__made" href="https://henneberg-webdesign.de" target="_blank" rel="noopener">Made by Henneberg Webdesign</a>
    </nav>
  </div>
</div>

<style>
  /* Widget: Desktop unten mittig, mobil schmale Karte am unteren Rand */
  .cb {
    position: fixed;
    left: 0;
    right: 0;
    margin-inline: auto;
    bottom: max(2.25rem, env(safe-area-inset-bottom));
    z-index: 80;
    width: min(44rem, calc(100vw - 1.5rem));
    background: var(--paper);
    border: 1px solid var(--line);
    box-shadow: 0 24px 60px -16px rgba(20, 19, 15, 0.35);
    max-height: calc(100dvh - 3rem);
    overflow-y: auto;
    transform-origin: 50% 100%;
  }
  .cb[hidden] { display: none; }
  .cb:not([hidden]) { animation: cb-pop 0.6s cubic-bezier(0.34, 1.56, 0.64, 1) both; }
  @keyframes cb-pop {
    from { opacity: 0; transform: translateY(40px) scale(0.92); }
    to { opacity: 1; transform: none; }
  }
  @media (prefers-reduced-motion: reduce) { .cb:not([hidden]) { animation: none; } }

  .cb__inner {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: center;
    column-gap: 1.75rem;
    row-gap: 0.4rem;
    padding: 1.15rem 1.4rem 1rem;
  }
  .cb__brand { display: none; }
  .cb__title {
    grid-column: 1;
    margin: 0;
    font-family: var(--font-head);
    font-weight: 600;
    font-size: 1.05rem;
    line-height: 1.25;
    color: var(--ink);
  }
  .cb__text {
    grid-column: 1;
    margin: 0;
    font-size: 0.82rem;
    line-height: 1.5;
    color: var(--ink-soft);
  }
  .cb__actions {
    grid-column: 2;
    grid-row: 1 / span 2;
    display: flex;
    gap: 0.5rem;
    margin: 0;
  }
  .cb__btn {
    padding: 0.75rem 1.1rem;
    border: 0;
    border-radius: 0;
    background: var(--ink);
    color: var(--paper);
    font-family: var(--font-head);
    font-weight: 700;
    font-size: 0.78rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    white-space: nowrap;
    cursor: pointer;
    transition: background 0.2s ease;
  }
  .cb__btn:hover { background: #000; }
  .cb__btn:focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; }

  .cb__links {
    grid-column: 1 / -1;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.2rem;
    margin-top: 0.4rem;
    padding-top: 0.6rem;
    border-top: 1px solid var(--line);
    font-size: 0.78rem;
  }
  .cb__links a { color: var(--muted); text-decoration: underline; text-underline-offset: 3px; }
  .cb__links a:hover { color: var(--ink); }
  .cb__made { margin-left: auto; }

  @media (max-width: 640px) {
    .cb { left: 0.75rem; right: 0.75rem; width: auto; margin-inline: 0; bottom: max(0.75rem, env(safe-area-inset-bottom)); }
    .cb__inner { grid-template-columns: 1fr; padding: 0.9rem 0.95rem 0.8rem; row-gap: 0.35rem; }
    .cb__title { font-size: 0.95rem; }
    .cb__text { font-size: 0.78rem; line-height: 1.4; }
    .cb__actions { grid-column: 1; grid-row: auto; margin-top: 0.4rem; }
    .cb__btn { flex: 1; padding: 0.7rem 0.5rem; }
    .cb__links { justify-content: center; margin-top: 0.2rem; padding-top: 0.5rem; }
    .cb__made { display: none; }
  }
</style>
