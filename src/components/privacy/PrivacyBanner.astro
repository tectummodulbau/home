---
// Consent-Banner über die volle Breite am unteren Rand: Marke, Überschrift,
// Erläuterung, zwei gleichwertige Buttons (Alles akzeptieren / Alles ablehnen)
// und Links. Die Feinauswahl liegt im Einstellungsdialog.
// Wird vom Consent-Manager eingeblendet, sonst per hidden ausgeblendet.
---

<div
  id="tectum-consent-banner"
  class="cb"
  role="dialog"
  aria-modal="false"
  aria-labelledby="cb-title"
  aria-describedby="cb-desc"
  hidden
>
  <div class="cb__inner">
    <p class="cb__brand" aria-hidden="true">Tectum <em>Modulbau</em></p>
    <h2 id="cb-title" class="cb__title">Wir nutzen Cookies und andere Technologien.</h2>
    <p id="cb-desc" class="cb__text">
      Diese Seite nutzt Cookies und Technologien zur Integration bestimmter Funktionen.
      Notwendige Cookies sind immer aktiv. Alle weiteren, etwa für Statistik, Marketing oder
      externe Inhalte, setzen wir nur mit Ihrer Einwilligung. Sie können Ihre Einwilligung
      jederzeit widerrufen oder Ihre Cookie Einstellungen anpassen. Details zu Zweck und
      Rechtsgrundlage finden Sie in unserer Datenschutzerklärung.
    </p>

    <div class="cb__actions">
      <button type="button" class="cb__btn" id="cb-accept-all">Alles akzeptieren</button>
      <button type="button" class="cb__btn" id="cb-reject-all">Alles ablehnen</button>
    </div>

    <nav class="cb__links" aria-label="Rechtliches">
      <a href="/impressum/">Impressum</a>
      <a href="/datenschutz/">Datenschutz</a>
      <a href="#" data-privacy-settings-trigger>Einstellungen</a>
      <a class="cb__made" href="https://henneberg-webdesign.de" target="_blank" rel="noopener">Made by Henneberg Webdesign</a>
    </nav>
  </div>
</div>

<style>
  .cb {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 80;
    background: var(--paper);
    box-shadow: 0 -8px 30px rgba(0, 0, 0, 0.14);
    padding-bottom: env(safe-area-inset-bottom);
    max-height: 100dvh;
    overflow-y: auto;
  }
  .cb[hidden] { display: none; }

  .cb__inner {
    max-width: 1200px;
    margin-inline: auto;
    padding: 1.1rem 1.5rem 1rem;
    text-align: center;
  }

  .cb__brand {
    margin: 0 0 0.4rem;
    font-family: var(--font-head);
    font-weight: 700;
    font-size: 1rem;
    color: var(--ink);
  }
  .cb__brand em {
    font-style: normal;
    font-weight: 400;
    color: var(--muted);
  }

  .cb__title {
    margin: 0 0 0.5rem;
    font-family: var(--font-head);
    font-weight: 500;
    font-size: clamp(1.1rem, 2.2vw, 1.5rem);
    line-height: 1.25;
    color: var(--ink);
  }

  .cb__text {
    margin: 0 auto;
    max-width: 62rem;
    font-size: 0.85rem;
    line-height: 1.55;
    color: var(--ink-soft);
  }

  .cb__actions {
    display: flex;
    justify-content: center;
    gap: 0.75rem;
    margin: 1rem 0 0.9rem;
  }
  .cb__btn {
    min-width: 17rem;
    padding: 0.85rem 1.5rem;
    border: 0;
    border-radius: 0;
    background: var(--ink);
    color: var(--paper);
    font-family: var(--font-head);
    font-weight: 700;
    font-size: 0.85rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    cursor: pointer;
    transition: background 0.2s ease;
  }
  .cb__btn:hover { background: #000; }
  .cb__btn:focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; }

  .cb__links {
    display: flex;
    justify-content: flex-start;
    gap: 1.4rem;
    padding-top: 0.7rem;
    border-top: 1px solid var(--line);
    font-size: 0.82rem;
  }
  .cb__links a {
    color: var(--muted);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .cb__links a:hover { color: var(--ink); }
  .cb__made {
    margin-left: auto;
    color: var(--muted);
  }

  @media (max-width: 640px) {
    .cb__inner { padding: 0.9rem 1rem 0.8rem; }
    .cb__text { font-size: 0.78rem; line-height: 1.45; }
    .cb__actions { flex-direction: column; gap: 0.5rem; margin: 0.8rem 0; }
    .cb__btn { min-width: 0; width: 100%; padding: 0.8rem 1rem; }
    .cb__links { justify-content: center; flex-wrap: wrap; gap: 0.5rem 1.1rem; }
    .cb__made { flex-basis: 100%; margin-left: 0; font-size: 0.74rem; }
  }
</style>
