>
  <main>
    <Hero />
    <StatsBand />
    <Prinzip />
    <Module />
    <Konfigurator />
    <Zielgruppen />
    <Vorteile />
    <Werk />
    <Video />
    <Vergleich />
    <Rechner />
    <Ablauf />
    <Faq />
    <LeadForm />
  </main>
</Layout>
