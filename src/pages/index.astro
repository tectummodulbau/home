---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import Zielgruppen from '../components/Zielgruppen.astro';
import Vorteile from '../components/Vorteile.astro';
import StatsBand from '../components/StatsBand.astro';
import Module from '../components/Module.astro';
import Werk from '../components/Werk.astro';
import Video from '../components/Video.astro';
import Konfigurator from '../components/Konfigurator.astro';
import Prinzip from '../components/Prinzip.astro';
import Vergleich from '../components/Vergleich.astro';
import Rechner from '../components/Rechner.astro';
import Ablauf from '../components/Ablauf.astro';
